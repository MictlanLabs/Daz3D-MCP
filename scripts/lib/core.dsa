// Daz3D-MCP core library.
// Shared helpers that every tool script can use. The MCP server prepends this
// file to each tool before sending it to Daz Studio.
//
// Compatibility rule: plain ES5 syntax only (no let/const, arrow functions,
// template strings or classes) so the same code runs on the Qt Script engine of
// Daz Studio 4.x and the newer engine of Daz Studio 6.

var DazMcp = {};

DazMcp.LIB_VERSION = "0.4.0";

// ---------------------------------------------------------------- JSON ----
// Daz Studio 4.x and 6 both ship a JSON object, but keep a tiny fallback so an
// unexpected engine never breaks every tool at once.
DazMcp.toJson = function (value) {
	if (typeof JSON !== "undefined" && JSON.stringify) {
		return JSON.stringify(value);
	}
	return DazMcp._stringify(value);
};

DazMcp.fromJson = function (text) {
	if (text === undefined || text === null || text === "") {
		return {};
	}
	if (typeof JSON !== "undefined" && JSON.parse) {
		return JSON.parse(text);
	}
	// The text always comes from our own MCP server, never from a third party.
	return eval("(" + text + ")");
};

DazMcp._stringify = function (v) {
	var i, out, keys, k;
	if (v === null || v === undefined) { return "null"; }
	if (typeof v === "number") { return isFinite(v) ? String(v) : "null"; }
	if (typeof v === "boolean") { return v ? "true" : "false"; }
	if (typeof v === "string") {
		return "\"" + v.replace(/\\/g, "\\\\").replace(/"/g, "\\\"")
			.replace(/\n/g, "\\n").replace(/\r/g, "\\r").replace(/\t/g, "\\t") + "\"";
	}
	if (v instanceof Array) {
		out = [];
		for (i = 0; i < v.length; i++) { out.push(DazMcp._stringify(v[i])); }
		return "[" + out.join(",") + "]";
	}
	out = [];
	for (k in v) {
		if (v.hasOwnProperty(k) && typeof v[k] !== "function") {
			out.push(DazMcp._stringify(String(k)) + ":" + DazMcp._stringify(v[k]));
		}
	}
	return "{" + out.join(",") + "}";
};

// -------------------------------------------------------------- errors ----
// Throw DazMcp.fail("code", "message") from a tool to return a clean error.
DazMcp.fail = function (code, message, details) {
	var e = new Error(message);
	e.dazmcpCode = code;
	e.dazmcpDetails = details || null;
	return e;
};

// ------------------------------------------------------------- logging ----
DazMcp._log = [];
DazMcp.log = function (message) {
	DazMcp._log.push(String(message));
};

// ------------------------------------------------------------- helpers ----
DazMcp.round = function (n, digits) {
	var f = Math.pow(10, digits === undefined ? 3 : digits);
	return Math.round(n * f) / f;
};

DazMcp.vec = function (v) {
	if (!v) { return null; }
	return [DazMcp.round(v.x), DazMcp.round(v.y), DazMcp.round(v.z)];
};

DazMcp.inherits = function (obj, className) {
	try {
		return obj && obj.inherits && obj.inherits(className);
	} catch (e) {
		return false;
	}
};

DazMcp.className = function (obj) {
	try {
		return obj.className();
	} catch (e) {
		return "";
	}
};

DazMcp.fileExists = function (path) {
	var info = new DzFileInfo(path);
	return info.exists();
};

// Short, stable type name for a scene node.
DazMcp.nodeType = function (node) {
	var inh = DazMcp.inherits;
	if (inh(node, "DzBone")) { return "bone"; }
	if (inh(node, "DzFigure") || inh(node, "DzLegacyFigure")) {
		try {
			if (node.getFollowTarget && node.getFollowTarget()) { return "fitted_figure"; }
		} catch (e) { /* older API */ }
		return "figure";
	}
	// DzLight inherits DzCamera, so test for lights first.
	if (inh(node, "DzLight")) { return "light"; }
	if (inh(node, "DzCamera")) { return "camera"; }
	if (inh(node, "DzGroupNode")) { return "group"; }
	if (inh(node, "DzSkeleton")) { return "skeleton"; }
	try {
		if (node.getObject && node.getObject()) { return "prop"; }
	} catch (e2) { /* ignore */ }
	return "node";
};

DazMcp.nodeRef = function (node) {
	if (!node) { return null; }
	return { name: node.getName(), label: node.getLabel() };
};

// Find a node by label first (what users see), then by internal name.
DazMcp.findNode = function (ref) {
	var node = null;
	if (!ref) { return null; }
	node = Scene.findNodeByLabel(ref);
	if (!node) { node = Scene.findNode(ref); }
	return node;
};

DazMcp.framesInfo = function () {
	var step = Scene.getTimeStep();
	var range = Scene.getAnimRange();
	var toFrame = function (t) { return step ? Math.round(t / step) : 0; };
	return {
		current: Scene.getFrame(),
		start: toFrame(range.start),
		end: toFrame(range.end)
	};
};

DazMcp.appInfo = function () {
	var info = {
		app: "Daz Studio",
		version: App.longVersionString,
		lib_version: DazMcp.LIB_VERSION
	};
	try { info.platform = App.platform(); } catch (e) { /* not available */ }
	try { info.headless = (App.getGraphicsMode() === DzApp.NoInterface); } catch (e2) { /* ignore */ }
	return info;
};


// ======================================================= stage 2 helpers ==
// Scenes and characters: nodes, figures, properties, cameras and lights.

DazMcp.isArray = function (v) {
	return Object.prototype.toString.call(v) === "[object Array]";
};

DazMcp.lower = function (s) {
	return String(s === undefined || s === null ? "" : s).toLowerCase();
};

// Two script wrappers of one Daz object do not always compare equal.
DazMcp.same = function (a, b) {
	if (!a || !b) { return false; }
	if (a === b) { return true; }
	try { return a.getElementID() === b.getElementID(); } catch (e) { return false; }
};

DazMcp.labels = function (nodes, max) {
	var out = [];
	var i;
	for (i = 0; i < nodes.length && out.length < (max || 40); i++) { out.push(nodes[i].getLabel()); }
	return out;
};

// Like findNode, but throws a helpful error when the node is not there.
DazMcp.requireNode = function (ref, what) {
	var node, all, i, near;
	if (!ref) { throw DazMcp.fail("bad_args", (what || "node") + " is required."); }
	node = DazMcp.findNode(ref);
	if (node) { return node; }
	all = Scene.getNodeList();
	near = [];
	for (i = 0; i < all.length; i++) {
		if (DazMcp.nodeType(all[i]) === "bone") { continue; }
		if (DazMcp.lower(all[i].getLabel()) === DazMcp.lower(ref)) { return all[i]; }
		if (DazMcp.lower(all[i].getLabel()).indexOf(DazMcp.lower(ref)) >= 0) { near.push(all[i].getLabel()); }
	}
	throw DazMcp.fail("not_found", "No node labeled " + ref + " in the scene.",
		{ similar: near.slice(0, 10) });
};

// The figure that owns a bone, or that a clothing item is fitted to.
DazMcp.ownerFigure = function (node) {
	var type = DazMcp.nodeType(node);
	var n = node;
	var guard = 0;
	if (type === "figure") { return node; }
	if (type === "bone") {
		try { if (node.getSkeleton && node.getSkeleton()) { return node.getSkeleton(); } } catch (e) { /* walk up */ }
		while (n && DazMcp.nodeType(n) === "bone" && guard < 200) { n = n.getNodeParent(); guard++; }
		return n;
	}
	if (type === "fitted_figure") { return node.getFollowTarget(); }
	return null;
};

DazMcp.requireFigure = function (ref) {
	var node = DazMcp.requireNode(ref, "figure");
	var type = DazMcp.nodeType(node);
	if (type === "figure" || type === "fitted_figure") { return node; }
	if (type === "bone") { return DazMcp.ownerFigure(node); }
	throw DazMcp.fail("bad_args", ref + " is a " + type + ", not a figure.");
};

DazMcp.selectOnly = function (node) {
	Scene.selectAllNodes(false);
	if (node) {
		node.select(true);
		try { Scene.setPrimarySelection(node); } catch (e) { /* older API: select() is enough */ }
	}
};

// "Genesis 9", "Genesis 8.1 Female"... from the figure's internal name.
DazMcp.generation = function (node) {
	var name = node ? String(node.getName()) : "";
	var m = /^Genesis(\d+)(?:_(\d+))?(Female|Male)?/i.exec(name);
	if (!m) {
		if (/^Genesis/i.test(name)) { return "Genesis"; }
		return null;
	}
	return "Genesis " + m[1] + (m[2] ? "." + m[2] : "") + (m[3] ? " " + m[3] : "");
};

DazMcp.followers = function (figure) {
	var all = Scene.getNodeList();
	var out = [];
	var i, t;
	for (i = 0; i < all.length; i++) {
		try {
			t = all[i].getFollowTarget ? all[i].getFollowTarget() : null;
			if (t && DazMcp.same(t, figure)) { out.push(all[i]); }
		} catch (e) { /* not a figure */ }
	}
	return out;
};

DazMcp.wearableKind = function (node) {
	var text = DazMcp.lower(node.getLabel() + " " + node.getName());
	if (/hair|brows|lashes|beard|mustache|bangs|ponytail|braid/.test(text)) { return "hair"; }
	return "clothing";
};

DazMcp.bones = function (figure) {
	var out = [];
	var i, n, kids;
	try {
		n = figure.getNumBones();
		for (i = 0; i < n; i++) { if (figure.getBone(i)) { out.push(figure.getBone(i)); } }
		return out;
	} catch (e) { /* fall back to the node tree */ }
	kids = figure.getNodeChildren(true);
	for (i = 0; i < kids.length; i++) {
		if (DazMcp.nodeType(kids[i]) === "bone") { out.push(kids[i]); }
	}
	return out;
};

DazMcp.findBone = function (figure, ref) {
	var bones, i, want;
	try { if (figure.findBone && figure.findBone(ref)) { return figure.findBone(ref); } } catch (e) { /* label next */ }
	try { if (figure.findBoneByLabel && figure.findBoneByLabel(ref)) { return figure.findBoneByLabel(ref); } } catch (e2) { /* scan */ }
	bones = DazMcp.bones(figure);
	want = DazMcp.lower(ref);
	for (i = 0; i < bones.length; i++) {
		if (DazMcp.lower(bones[i].getName()) === want || DazMcp.lower(bones[i].getLabel()) === want) { return bones[i]; }
	}
	return null;
};

// ---------------------------------------------------------- properties ----
DazMcp.findProp = function (element, labels) {
	var i, j, p, n, want;
	if (!element) { return null; }
	if (!DazMcp.isArray(labels)) { labels = [labels]; }
	for (j = 0; j < labels.length; j++) {
		try { p = element.findPropertyByLabel(labels[j]); if (p) { return p; } } catch (e) { /* scan */ }
		try { p = element.findProperty(labels[j]); if (p) { return p; } } catch (e2) { /* scan */ }
	}
	try { n = element.getNumProperties(); } catch (e3) { return null; }
	for (j = 0; j < labels.length; j++) {
		want = DazMcp.lower(labels[j]);
		for (i = 0; i < n; i++) {
			p = element.getProperty(i);
			if (DazMcp.lower(p.getLabel()) === want || DazMcp.lower(p.getName()) === want) { return p; }
		}
	}
	return null;
};

DazMcp.propType = function (p) {
	var inh = DazMcp.inherits;
	if (inh(p, "DzColorProperty")) { return "color"; }
	if (inh(p, "DzEnumProperty")) { return "enum"; }
	if (inh(p, "DzBoolProperty")) { return "bool"; }
	if (inh(p, "DzImageProperty")) { return "image"; }
	if (inh(p, "DzFileProperty") || inh(p, "DzStringProperty")) { return "string"; }
	if (inh(p, "DzIntProperty")) { return "int"; }
	if (inh(p, "DzFloatProperty") || inh(p, "DzNumericProperty")) { return "float"; }
	return "other";
};

DazMcp.colorToArray = function (c) {
	if (!c) { return null; }
	var r = typeof c.red === "function" ? c.red() : c.red;
	var g = typeof c.green === "function" ? c.green() : c.green;
	var b = typeof c.blue === "function" ? c.blue() : c.blue;
	return [DazMcp.round(r / 255), DazMcp.round(g / 255), DazMcp.round(b / 255)];
};

// [r, g, b] from 0 to 1, or "#rrggbb".
DazMcp.toColor = function (v) {
	var m;
	if (typeof v === "string") {
		m = /^#?([0-9a-f]{2})([0-9a-f]{2})([0-9a-f]{2})$/i.exec(v);
		if (!m) { throw DazMcp.fail("bad_args", "Colors are [r, g, b] from 0 to 1 or \"#rrggbb\" (got " + v + ")."); }
		return new Color(parseInt(m[1], 16), parseInt(m[2], 16), parseInt(m[3], 16));
	}
	if (!DazMcp.isArray(v) || v.length < 3) {
		throw DazMcp.fail("bad_args", "Colors are [r, g, b] from 0 to 1 or \"#rrggbb\".");
	}
	var c = function (x) { return Math.max(0, Math.min(255, Math.round(Number(x) * 255))); };
	return new Color(c(v[0]), c(v[1]), c(v[2]));
};

DazMcp.mapPath = function (p) {
	try {
		var t = p.getMapValue();
		return t ? String(t.getFilename()) : null;
	} catch (e) {
		return null;
	}
};

DazMcp.propInfo = function (p) {
	var type = DazMcp.propType(p);
	var info = { label: p.getLabel(), name: p.getName(), type: type };
	try {
		if (type === "color") { info.value = DazMcp.colorToArray(p.getColorValue()); }
		else if (type === "enum") { info.value = String(p.getStringValue()); info.index = p.getValue(); }
		else if (type === "bool") { info.value = !!p.getBoolValue(); }
		else if (type === "string") { info.value = String(p.getValue()); }
		else if (type === "image") { info.value = null; }
		else {
			info.value = DazMcp.round(p.getValue(), 4);
			try { info.min = DazMcp.round(p.getMin(), 4); info.max = DazMcp.round(p.getMax(), 4); } catch (e) { /* no limits */ }
		}
	} catch (e2) { info.value = null; }
	try { if (p.isMappable && p.isMappable()) { info.map = DazMcp.mapPath(p); } } catch (e3) { /* not mappable */ }
	return info;
};

// value: number, bool, string (enum item), color, or {map: path|null, value: x}.
DazMcp.setPropValue = function (p, value) {
	var type = DazMcp.propType(p);
	var i, n, want, tex;
	if (value !== null && typeof value === "object" && !DazMcp.isArray(value)) {
		if (value.hasOwnProperty("map")) {
			if (value.map === null || value.map === "") {
				p.setMap(null);
			} else {
				if (!DazMcp.fileExists(value.map)) { throw DazMcp.fail("not_found", "Image not found: " + value.map); }
				tex = App.getImageMgr().getImage(value.map);
				p.setMap(tex);
			}
		}
		if (value.hasOwnProperty("value")) { DazMcp.setPropValue(p, value.value); }
		return DazMcp.propInfo(p);
	}
	if (type === "color") {
		p.setColorValue(DazMcp.toColor(value));
	} else if (type === "enum") {
		if (typeof value === "number") {
			p.setValue(value);
		} else {
			n = p.getNumItems();
			want = DazMcp.lower(value);
			for (i = 0; i < n; i++) {
				if (DazMcp.lower(p.getItem(i)) === want) { p.setValue(i); return DazMcp.propInfo(p); }
			}
			throw DazMcp.fail("bad_args", p.getLabel() + " has no option " + value + ".");
		}
	} else if (type === "bool") {
		try { p.setBoolValue(!!value); } catch (e) { p.setValue(value ? 1 : 0); }
	} else if (type === "string") {
		p.setValue(String(value));
	} else {
		if (typeof value !== "number") {
			throw DazMcp.fail("bad_args", p.getLabel() + " needs a number (got " + DazMcp.toJson(value) + ").");
		}
		p.setValue(value);
	}
	return DazMcp.propInfo(p);
};

// Sets {label: value} on an element; returns {set: [...], not_found: [...]}.
DazMcp.setProps = function (element, values) {
	var out = { set: [], not_found: [] };
	var key, p;
	for (key in values) {
		if (!values.hasOwnProperty(key)) { continue; }
		p = DazMcp.findProp(element, key);
		if (!p) { out.not_found.push(key); continue; }
		out.set.push(DazMcp.setPropValue(p, values[key]));
	}
	return out;
};

// ------------------------------------------------------------ geometry ----
DazMcp.toVec3 = function (a) {
	return new DzVec3(Number(a[0]), Number(a[1]), Number(a[2]));
};

DazMcp.checkVec = function (v, what) {
	if (v === undefined || v === null) { return null; }
	if (!DazMcp.isArray(v) || v.length !== 3 || typeof v[0] !== "number" ||
			typeof v[1] !== "number" || typeof v[2] !== "number") {
		throw DazMcp.fail("bad_args", what + " must be [x, y, z] numbers.");
	}
	return v;
};

// World bounding box of nodes plus whatever is fitted to them.
DazMcp.bboxOf = function (nodes) {
	var min = null;
	var max = null;
	var i, j, list, box;
	var grow = function (b) {
		if (!b || !b.isValid()) { return; }
		if (!min) { min = [b.min.x, b.min.y, b.min.z]; max = [b.max.x, b.max.y, b.max.z]; return; }
		min = [Math.min(min[0], b.min.x), Math.min(min[1], b.min.y), Math.min(min[2], b.min.z)];
		max = [Math.max(max[0], b.max.x), Math.max(max[1], b.max.y), Math.max(max[2], b.max.z)];
	};
	for (i = 0; i < nodes.length; i++) {
		list = [nodes[i]].concat(DazMcp.followers(nodes[i]));
		for (j = 0; j < list.length; j++) {
			try { box = list[j].getWSBoundingBox(); grow(box); } catch (e) { /* no geometry */ }
		}
		if (!min) {
			box = nodes[i].getWSPos();
			min = [box.x, box.y, box.z];
			max = [box.x, box.y, box.z];
		}
	}
	if (!min) { return null; }
	return { min: min, max: max,
		center: [(min[0] + max[0]) / 2, (min[1] + max[1]) / 2, (min[2] + max[2]) / 2] };
};

// A point from [x, y, z] or from a node label (the center of its bounding box).
DazMcp.resolvePoint = function (ref, what) {
	if (DazMcp.isArray(ref)) { return DazMcp.checkVec(ref, what); }
	var node = DazMcp.requireNode(ref, what);
	var type = DazMcp.nodeType(node);
	var p;
	if (type === "bone" || type === "camera" || type === "light" || type === "node") {
		p = node.getWSPos();
		return [p.x, p.y, p.z];
	}
	return DazMcp.bboxOf([node]).center;
};

DazMcp.setTransform = function (node, pos, rot, scale) {
	if (pos) {
		node.getXPosControl().setValue(pos[0]);
		node.getYPosControl().setValue(pos[1]);
		node.getZPosControl().setValue(pos[2]);
	}
	if (rot) {
		node.getXRotControl().setValue(rot[0]);
		node.getYRotControl().setValue(rot[1]);
		node.getZRotControl().setValue(rot[2]);
	}
	if (scale !== undefined && scale !== null) {
		node.getScaleControl().setValue(scale);
	}
};

DazMcp.transformOf = function (node) {
	return {
		position: [DazMcp.round(node.getXPosControl().getValue()), DazMcp.round(node.getYPosControl().getValue()),
			DazMcp.round(node.getZPosControl().getValue())],
		rotation: [DazMcp.round(node.getXRotControl().getValue()), DazMcp.round(node.getYRotControl().getValue()),
			DazMcp.round(node.getZRotControl().getValue())],
		scale: DazMcp.round(node.getScaleControl().getValue())
	};
};

// Rotation (degrees) that points a camera or light at a target. Cameras and
// lights look down their local -Z axis; Daz rotates them Y first, then X.
DazMcp.aimRotation = function (from, to) {
	var dx = to[0] - from[0];
	var dy = to[1] - from[1];
	var dz = to[2] - from[2];
	var h = Math.sqrt(dx * dx + dz * dz);
	var deg = 180 / Math.PI;
	return [Math.atan2(dy, h) * deg, Math.atan2(-dx, -dz) * deg, 0];
};

DazMcp.renderAspect = function () {
	var size = DazMcp.renderSize();
	return size && size.height ? size.width / size.height : 16 / 9;
};

DazMcp.renderSize = function () {
	var opts, s;
	try {
		opts = App.getRenderMgr().getRenderOptions();
		s = opts.getImageSize ? opts.getImageSize() : opts.imageSize;
		if (s) { return { width: s.width, height: s.height }; }
	} catch (e) { /* default below */ }
	return null;
};

DazMcp.setFocalLength = function (camera, mm) {
	var p = DazMcp.findProp(camera, ["Focal Length", "Focal Length (mm)"]);
	if (p) { p.setValue(mm); return; }
	camera.setFocalLength(mm);
};

DazMcp.getFocalLength = function (camera) {
	try { return camera.getFocalLength(); } catch (e) { /* property */ }
	var p = DazMcp.findProp(camera, ["Focal Length"]);
	return p ? p.getValue() : 65;
};

// Camera position that fits nodes in the frame.
//   yaw:   degrees around the target; 0 = in front (+Z), 90 = on their left (+X)
//   pitch: degrees above the target's center
//   margin: 1.1 leaves 10% of room around them
DazMcp.framePosition = function (box, focalMm, aspect, yaw, pitch, margin) {
	var deg = Math.PI / 180;
	var halfW = Math.atan(18 / focalMm);            // 36 mm wide frame
	var halfH = Math.atan(18 / (aspect * focalMm));
	var sx = box.max[0] - box.min[0];
	var sy = box.max[1] - box.min[1];
	var sz = box.max[2] - box.min[2];
	var y = yaw * deg;
	var p = pitch * deg;
	var width = Math.abs(sx * Math.cos(y)) + Math.abs(sz * Math.sin(y));
	var depth = Math.abs(sx * Math.sin(y)) + Math.abs(sz * Math.cos(y));
	var height = sy * Math.cos(p) + depth * Math.abs(Math.sin(p));
	var dist = Math.max((height / 2) / Math.tan(halfH), (width / 2) / Math.tan(halfW)) * margin + depth / 2;
	var c = box.center;
	return [c[0] + dist * Math.sin(y) * Math.cos(p), c[1] + dist * Math.sin(p), c[2] + dist * Math.cos(y) * Math.cos(p)];
};

DazMcp.viewport3d = function () {
	try { return MainWindow.getViewportMgr().getActiveViewport().get3DViewport(); } catch (e) { return null; }
};

// Shared by camera_create/camera_set and light_create/light_set.
DazMcp.placeAndAim = function (node, args, isCamera) {
	var pos = DazMcp.checkVec(args.position, "position");
	var target = null;
	var box, focal;
	if (isCamera && args.frame && args.frame.length) {
		var frameNodes = [];
		var i;
		for (i = 0; i < args.frame.length; i++) { frameNodes.push(DazMcp.requireNode(args.frame[i], "frame")); }
		box = DazMcp.bboxOf(frameNodes);
		focal = DazMcp.getFocalLength(node);
		if (!pos) {
			pos = DazMcp.framePosition(box, focal, DazMcp.renderAspect(),
				args.yaw || 0, args.pitch === undefined ? 5 : args.pitch, args.margin || 1.1);
		}
		target = box.center;
	}
	if (args.look_at !== undefined && args.look_at !== null) { target = DazMcp.resolvePoint(args.look_at, "look_at"); }
	if (pos) { DazMcp.setTransform(node, pos, null, null); }
	if (target) {
		var from = pos;
		if (!from) { var w = node.getWSPos(); from = [w.x, w.y, w.z]; }
		DazMcp.setTransform(node, null, DazMcp.aimRotation(from, target), null);
	} else if (args.rotation) {
		DazMcp.setTransform(node, null, DazMcp.checkVec(args.rotation, "rotation"), null);
	}
	return target;
};

DazMcp.idOf = function (node) {
	try { return String(node.getElementID()); } catch (e) { return node.getName() + "|" + node.getLabel(); }
};

DazMcp.cameraApply = function (cam, args) {
	var target, v3d, out;
	if (args.focal_length) { DazMcp.setFocalLength(cam, args.focal_length); }
	target = DazMcp.placeAndAim(cam, args, true);
	if (args.make_active === true) {
		v3d = DazMcp.viewport3d();
		if (v3d) { v3d.setCamera(cam); }
	}
	out = DazMcp.transformOf(cam);
	out.label = cam.getLabel();
	out.focal_length = DazMcp.round(DazMcp.getFocalLength(cam));
	out.looking_at = target ? [DazMcp.round(target[0]), DazMcp.round(target[1]), DazMcp.round(target[2])] : null;
	v3d = DazMcp.viewport3d();
	out.active = !!(v3d && DazMcp.same(v3d.getCamera(), cam));
	return out;
};

// --------------------------------------------------------------- morphs ----
// Shape dials are the value properties of DzMorph modifiers on the object.
// Many pose and face dials (Eye Blink, Brow Up, Jaw Open on Genesis 8.1, the
// "Expressions 8.1" dials...) are not morphs but properties of the figure node
// that drive morphs and bones; opts.controls adds those too.
//   opts.query, opts.only_nonzero, opts.include_hidden, opts.limit, opts.raw, opts.controls
DazMcp.CONTROL_PATH = /^\/(Pose Controls|Actor|Hidden|Morphs|Shapes)(\/|$)/;

DazMcp.morphList = function (node, opts) {
	var obj = null;
	var out = [];
	var raw = [];
	var total = 0;
	var seen = {};
	var words = opts.query ? DazMcp.lower(opts.query).split(/\s+/) : [];
	var limit = opts.limit || 100;
	var i, j, n, mod, prop, text, ok, val, group, name;
	var consider = function (p, nm, kind) {
		if (!p || seen[nm]) { return; }
		try { if (!opts.include_hidden && p.isHidden()) { return; } } catch (e2) { /* ignore */ }
		val = p.getValue();
		if (typeof val !== "number") { return; }
		if (opts.only_nonzero) {
			// "in use" = away from its default (a few dials rest at 0.25 or 1)
			var dv = 0;
			try { dv = Number(p.getDefaultValue()) || 0; } catch (e6) { dv = 0; }
			if (Math.abs(val - dv) < 1e-6) { return; }
		}
		group = "";
		try { group = String(p.getPath()); } catch (e3) { group = ""; }
		if (kind === "control" && !DazMcp.CONTROL_PATH.test(group)) { return; }
		seen[nm] = true;
		text = DazMcp.lower(p.getLabel() + " " + nm + " " + group);
		ok = true;
		for (j = 0; j < words.length; j++) { if (words[j] && text.indexOf(words[j]) < 0) { ok = false; break; } }
		if (!ok) { return; }
		total++;
		if (opts.raw) { raw.push({ prop: p, name: nm, kind: kind }); return; }
		if (out.length >= limit) { return; }
		var entry = { label: p.getLabel(), name: nm, group: group, value: DazMcp.round(val, 4) };
		try { entry.min = DazMcp.round(p.getMin(), 3); entry.max = DazMcp.round(p.getMax(), 3); } catch (e4) { /* ignore */ }
		if (kind === "control") { entry.control = true; }
		out.push(entry);
	};
	try { obj = node.getObject(); } catch (e) { obj = null; }
	if (obj) {
		n = obj.getNumModifiers();
		for (i = 0; i < n; i++) {
			mod = obj.getModifier(i);
			if (!DazMcp.inherits(mod, "DzMorph")) { continue; }
			consider(mod.getValueControl(), String(mod.getName()), "morph");
		}
	}
	if (opts.controls) {
		try { n = node.getNumProperties(); } catch (e5) { n = 0; }
		for (i = 0; i < n; i++) {
			prop = node.getProperty(i);
			if (!DazMcp.inherits(prop, "DzFloatProperty")) { continue; }
			name = String(prop.getName());
			consider(prop, name, "control");
		}
	}
	return { morphs: out, total: total, truncated: total > out.length && !opts.raw, raw: raw };
};

// --------------------------------------------------------------- lights ----
DazMcp.LIGHT_POWER = ["Luminous Flux (Lumen)", "Flux", "Luminous Flux", "Intensity"];

DazMcp.lightApply = function (light, args) {
	var res = { set: [], not_found: [] };
	var p, k;
	DazMcp.placeAndAim(light, args, false);
	if (args.power !== undefined && args.power !== null) {
		p = DazMcp.findProp(light, DazMcp.LIGHT_POWER);
		if (p) { res.set.push(DazMcp.setPropValue(p, args.power)); } else { res.not_found.push("power"); }
	}
	if (args.color) {
		p = DazMcp.findProp(light, ["Color", "Light Color"]);
		if (p) { res.set.push(DazMcp.setPropValue(p, args.color)); } else { res.not_found.push("color"); }
	}
	if (args.spread_angle !== undefined && args.spread_angle !== null) {
		p = DazMcp.findProp(light, ["Spread Angle"]);
		if (p) { res.set.push(DazMcp.setPropValue(p, args.spread_angle)); } else { res.not_found.push("spread_angle"); }
	}
	if (args.properties) {
		k = DazMcp.setProps(light, args.properties);
		res.set = res.set.concat(k.set);
		res.not_found = res.not_found.concat(k.not_found);
	}
	var out = DazMcp.transformOf(light);
	out.label = light.getLabel();
	out.class = DazMcp.className(light);
	out.set = res.set;
	out.not_found = res.not_found;
	return out;
};

// ------------------------------------------------------- render settings ----
// Iray settings live on the render element objects; the environment (dome,
// HDRI) lives there too, or on an "Environment Options" node in newer scenes.
DazMcp.renderElements = function () {
	var out = [];
	var i, all, list;
	try {
		list = App.getRenderMgr().getRenderElementObjects();
		for (i = 0; i < list.length; i++) { out.push(list[i]); }
	} catch (e) { /* none */ }
	all = Scene.getNodeList();
	for (i = 0; i < all.length; i++) {
		if (DazMcp.inherits(all[i], "DzEnvironmentNode")) { out.unshift(all[i]); }
	}
	return out;
};

DazMcp.findRenderProp = function (labels) {
	var els = DazMcp.renderElements();
	var i, p;
	for (i = 0; i < els.length; i++) {
		p = DazMcp.findProp(els[i], labels);
		if (p) { return p; }
	}
	return null;
};

DazMcp.RENDER_LABELS = {
	max_samples: ["Max Samples"],
	max_time: ["Max Time (secs)", "Max Time"],
	quality: ["Rendering Quality"]
};

DazMcp.applyRenderSettings = function (args) {
	var opts = App.getRenderMgr().getRenderOptions();
	var notFound = [];
	var key, p, r, size;
	if (args.width || args.height) {
		size = DazMcp.renderSize() || { width: 1920, height: 1080 };
		var w = args.width || Math.round((args.height) * size.width / size.height);
		var h = args.height || Math.round((args.width) * size.height / size.width);
		try { opts.setAspectConstrained(false); } catch (e0) { /* ignore */ }
		try {
			opts.setImageSize(new Size(w, h));
		} catch (e) {
			// Daz Studio 6: DzRenderOptions has no setImageSize; the size lives in
			// the "Pixel Size (Global)" DzInt2Property of the General Render element.
			p = DazMcp.findRenderProp(["Pixel Size (Global)", "Pixel Size"]);
			r = DazMcp.findRenderProp(["Constrain Proportions (Global)", "Constrain Proportions"]);
			if (p && typeof DzInt2 !== "undefined") {
				// With "Dimension Preset" = "Active Viewport" (the default) Iray
				// renders at the viewport's size and ignores Pixel Size.
				var preset = DazMcp.findRenderProp(["Dimension Preset (Global)", "Dimension Preset"]);
				if (preset) { preset.setValue("Custom"); }
				if (r) { r.setValue(false); }
				p.setInt2Value(new DzInt2(w, h));
				try { opts.setAspectRatio(w, h); } catch (e1) { /* ignore */ }
			} else {
				opts.imageSize = new Size(w, h);
			}
		}
	}
	if (args.quality !== undefined && args.quality !== null) {
		p = DazMcp.findRenderProp(["Rendering Quality Enable"]);
		if (p) { DazMcp.setPropValue(p, true); }
	}
	for (key in DazMcp.RENDER_LABELS) {
		if (!DazMcp.RENDER_LABELS.hasOwnProperty(key) || args[key] === undefined || args[key] === null) { continue; }
		p = DazMcp.findRenderProp(DazMcp.RENDER_LABELS[key]);
		if (p) { DazMcp.setPropValue(p, args[key]); } else { notFound.push(key); }
	}
	if (args.properties) {
		for (key in args.properties) {
			if (!args.properties.hasOwnProperty(key)) { continue; }
			p = DazMcp.findRenderProp([key]);
			if (p) { DazMcp.setPropValue(p, args.properties[key]); } else { notFound.push(key); }
		}
	}

	var out = { renderer: null, not_found: notFound };
	try { out.renderer = String(App.getRenderMgr().getActiveRenderer().getName()); } catch (e2) { /* ignore */ }
	size = DazMcp.renderSize();
	if (size) { out.width = size.width; out.height = size.height; }
	for (key in DazMcp.RENDER_LABELS) {
		if (!DazMcp.RENDER_LABELS.hasOwnProperty(key)) { continue; }
		p = DazMcp.findRenderProp(DazMcp.RENDER_LABELS[key]);
		if (p) { out[key] = DazMcp.propInfo(p).value; }
	}
	return out;
};

// Materials of a node, optionally only the named surfaces.
DazMcp.materialsOf = function (node, names) {
	var shape = null;
	var out = [];
	var i, m, want, found, missing;
	try { shape = node.getObject().getCurrentShape(); } catch (e) { shape = null; }
	if (!shape) { throw DazMcp.fail("bad_args", node.getLabel() + " has no geometry, so it has no surfaces."); }
	want = {};
	if (names && names.length) {
		for (i = 0; i < names.length; i++) { want[DazMcp.lower(names[i])] = names[i]; }
	} else {
		want = null;
	}
	found = {};
	for (i = 0; i < shape.getNumMaterials(); i++) {
		m = shape.getMaterial(i);
		if (want && !want[DazMcp.lower(m.getLabel())] && !want[DazMcp.lower(m.getName())]) { continue; }
		found[DazMcp.lower(m.getLabel())] = true;
		found[DazMcp.lower(m.getName())] = true;
		out.push(m);
	}
	if (want) {
		missing = [];
		for (i in want) { if (want.hasOwnProperty(i) && !found[i]) { missing.push(want[i]); } }
		if (missing.length) {
			var all = [];
			for (i = 0; i < shape.getNumMaterials(); i++) { all.push(shape.getMaterial(i).getLabel()); }
			throw DazMcp.fail("not_found", "No surface " + missing.join(", ") + " on " + node.getLabel() + ".",
				{ surfaces: all });
		}
	}
	return out;
};


// ======================================================= stage 3 helpers ==
// Third-party assets: libraries, imported meshes and the Transfer Utility.

// Same folder, whatever the slashes, case or trailing slash.
DazMcp.samePath = function (a, b) {
	var norm = function (p) { return DazMcp.lower(p).replace(/\\/g, "/").replace(/\/+$/, ""); };
	return norm(a) === norm(b);
};

DazMcp.contentDirs = function () {
	var mgr = App.getContentMgr();
	var out = [];
	var i, n;
	n = mgr.getNumContentDirectories();
	for (i = 0; i < n; i++) { out.push({ path: String(mgr.getContentDirectoryPath(i)), kind: "daz" }); }
	try {
		n = mgr.getNumPoserDirectories();
		for (i = 0; i < n; i++) { out.push({ path: String(mgr.getPoserDirectoryPath(i)), kind: "poser" }); }
	} catch (e) { /* not available */ }
	return out;
};

// Bones rotated more than half a degree. Eyes do not count: Genesis 9 loads
// with its eyes turned 3 degrees (l_eye -3, r_eye +3 Side-Side), and they never
// move clothing.
DazMcp.posedBones = function (figure) {
	var bones = DazMcp.bones(figure);
	var out = [];
	var i, b;
	for (i = 0; i < bones.length; i++) {
		b = bones[i];
		if (/^[lr]_?eye$|^(left|right)eye$/i.test(b.getName())) { continue; }
		if (Math.abs(b.getXRotControl().getValue()) > 0.5 || Math.abs(b.getYRotControl().getValue()) > 0.5 ||
				Math.abs(b.getZRotControl().getValue()) > 0.5) {
			out.push(b.getName());
		}
	}
	return out;
};

// Nodes in the scene now that were not in a snapshot (see DazMcp.snapshot).
DazMcp.snapshot = function () {
	var all = Scene.getNodeList();
	var seen = {};
	var i;
	for (i = 0; i < all.length; i++) { seen[DazMcp.idOf(all[i])] = true; }
	return seen;
};

DazMcp.addedSince = function (before) {
	var all = Scene.getNodeList();
	var out = [];
	var i;
	for (i = 0; i < all.length; i++) {
		if (before[DazMcp.idOf(all[i])]) { continue; }
		if (DazMcp.nodeType(all[i]) === "bone") { continue; }
		out.push(all[i]);
	}
	return out;
};

// A property on the node, its object, or one of the object's modifiers
// (mesh smoothing and collision live on a modifier).
DazMcp.findPropDeep = function (node, labels) {
	var p = DazMcp.findProp(node, labels);
	var obj, i, n;
	if (p) { return p; }
	try { obj = node.getObject(); } catch (e) { obj = null; }
	if (!obj) { return null; }
	p = DazMcp.findProp(obj, labels);
	if (p) { return p; }
	try { n = obj.getNumModifiers(); } catch (e2) { n = 0; }
	for (i = 0; i < n; i++) {
		p = DazMcp.findProp(obj.getModifier(i), labels);
		if (p) { return p; }
	}
	return null;
};

DazMcp.surfaceLabels = function (node) {
	var out = [];
	var shape, i;
	try { shape = node.getObject().getCurrentShape(); } catch (e) { shape = null; }
	if (!shape) { return out; }
	for (i = 0; i < shape.getNumMaterials(); i++) { out.push(shape.getMaterial(i).getLabel()); }
	return out;
};

DazMcp.boxInfo = function (box) {
	if (!box) { return null; }
	var r = function (v) { return [DazMcp.round(v[0], 2), DazMcp.round(v[1], 2), DazMcp.round(v[2], 2)]; };
	return { min: r(box.min), max: r(box.max),
		size: r([box.max[0] - box.min[0], box.max[1] - box.min[1], box.max[2] - box.min[2]]) };
};


// ======================================================= stage 4 helpers ==
// Animation: time, keyframes and the channels (animated values) of a node.
// Daz counts time in ticks, 4800 per second; a frame lasts getTimeStep() ticks.

DazMcp.TICKS_PER_SECOND = 4800;

DazMcp.fps = function () {
	var step = Scene.getTimeStep();
	return step ? DazMcp.round(DazMcp.TICKS_PER_SECOND / step, 3) : 30;
};

DazMcp.frameTime = function (frame) {
	return Math.round(Number(frame) * Scene.getTimeStep());
};

DazMcp.timeFrame = function (t) {
	return DazMcp.round(t / Scene.getTimeStep(), 3);
};

DazMcp.TRANSFORMS = {
	position: ["getXPosControl", "getYPosControl", "getZPosControl"],
	rotation: ["getXRotControl", "getYRotControl", "getZRotControl"],
	scale: ["getScaleControl"]
};

DazMcp.numKeys = function (prop) {
	try { return prop.getNumKeys(); } catch (e) { return 0; }
};

// Daz Studio 6 keeps one key at frame 0 on every property, animated or not,
// so a property is animated only when it has more keys, or its one key is
// somewhere else.
DazMcp.isAnimated = function (prop) {
	var n = DazMcp.numKeys(prop);
	if (n > 1) { return true; }
	if (n === 1) {
		try { return prop.getKeyTime(0) !== 0; } catch (e) { return true; }
	}
	return false;
};

// [[time, value], ...] of an animated property.
DazMcp.readKeys = function (prop) {
	var out = [];
	var n = DazMcp.numKeys(prop);
	var i;
	for (i = 0; i < n; i++) { out.push([prop.getKeyTime(i), prop.getKeyValue(i)]); }
	return out;
};

// Removes keys between two times (ticks, inclusive), or all of them.
DazMcp.clearKeys = function (prop, start, end) {
	var before = DazMcp.numKeys(prop);
	var i, t;
	if (!before) { return 0; }
	if (start === undefined || start === null) {
		try { prop.deleteAllKeys(); return before; } catch (e) { start = -1e12; end = 1e12; }
	}
	try {
		prop.deleteKeys(new DzTimeRange(start, end));
	} catch (e2) {
		for (i = before - 1; i >= 0; i--) {
			t = prop.getKeyTime(i);
			if (t >= start && t <= end) { prop.deleteKey(i); }
		}
	}
	return before - DazMcp.numKeys(prop);
};

DazMcp.setKey = function (prop, time, value) {
	prop.setValue(time, value);
};

// The value of a property at a time (ticks).
DazMcp.valueAt = function (prop, time) {
	try { return prop.getValue(time); } catch (e) { /* set the scene time instead */ }
	var keep = Scene.getTime();
	Scene.setTime(time);
	var v = prop.getValue();
	Scene.setTime(keep);
	return v;
};

DazMcp.transformControls = function (node, kind) {
	var names = DazMcp.TRANSFORMS[kind];
	var out = [];
	var i;
	for (i = 0; i < names.length; i++) { out.push(node[names[i]]()); }
	return out;
};

// Everything of a node that can be animated, as channels:
//   {group: "node"|"bones"|"morphs", item, kind, axis, prop}
//   opts.bones: false to skip bones; opts.morphs: false to skip morphs;
//   opts.only_keyed: only channels with keys; opts.animated: only animated
//   channels (see DazMcp.isAnimated); opts.bone_list: only these bones.
DazMcp.channels = function (node, opts) {
	var out = [];
	var kinds = ["position", "rotation", "scale"];
	var i, j, k, controls, bones, b, morphs, want;
	opts = opts || {};
	var add = function (group, item, kind, axis, prop) {
		if (opts.only_keyed && !DazMcp.numKeys(prop)) { return; }
		if (opts.animated && !DazMcp.isAnimated(prop)) { return; }
		out.push({ group: group, item: item, kind: kind, axis: axis, prop: prop });
	};
	if (opts.node !== false) {
		for (k = 0; k < kinds.length; k++) {
			controls = DazMcp.transformControls(node, kinds[k]);
			for (j = 0; j < controls.length; j++) { add("node", node.getLabel(), kinds[k], j, controls[j]); }
		}
	}
	if (opts.bones !== false && DazMcp.inherits(node, "DzSkeleton")) {
		want = null;
		if (opts.bone_list) {
			want = {};
			for (i = 0; i < opts.bone_list.length; i++) { want[DazMcp.lower(opts.bone_list[i])] = true; }
		}
		bones = DazMcp.bones(node);
		for (i = 0; i < bones.length; i++) {
			b = bones[i];
			if (want && !want[DazMcp.lower(b.getName())] && !want[DazMcp.lower(b.getLabel())]) { continue; }
			for (k = 0; k < 2; k++) {
				controls = DazMcp.transformControls(b, kinds[k]);
				for (j = 0; j < 3; j++) { add("bones", String(b.getName()), kinds[k], j, controls[j]); }
			}
		}
	}
	if (opts.morphs !== false) {
		morphs = DazMcp.morphList(node, { raw: true, include_hidden: true, controls: true }).raw;
		for (i = 0; i < morphs.length; i++) { add("morphs", morphs[i].prop.getLabel(), "value", 0, morphs[i].prop); }
	}
	return out;
};

// First and last key time (ticks) over channels; null when nothing is keyed.
DazMcp.keyRange = function (channels) {
	var lo = null;
	var hi = null;
	var i, n, a, b;
	for (i = 0; i < channels.length; i++) {
		n = DazMcp.numKeys(channels[i].prop);
		if (!n) { continue; }
		a = channels[i].prop.getKeyTime(0);
		b = channels[i].prop.getKeyTime(n - 1);
		lo = lo === null ? a : Math.min(lo, a);
		hi = hi === null ? b : Math.max(hi, b);
	}
	return lo === null ? null : { start: lo, end: hi };
};

// Moves keys to new times: map(time) -> new time. Two keys that land on the
// same tick keep the later one.
DazMcp.remapKeys = function (prop, map) {
	var keys = DazMcp.readKeys(prop);
	var i, t;
	if (!keys.length) { return 0; }
	DazMcp.clearKeys(prop);
	for (i = 0; i < keys.length; i++) {
		t = Math.round(map(keys[i][0]));
		DazMcp.setKey(prop, t, keys[i][1]);
	}
	return keys.length;
};

// Makes the scene's animation range reach a frame.
DazMcp.extendRange = function (lastFrame) {
	var range = Scene.getAnimRange();
	var end = DazMcp.frameTime(lastFrame);
	if (end > range.end) {
		Scene.setAnimRange(new DzTimeRange(range.start, end));
		try { Scene.setPlayRange(new DzTimeRange(range.start, end)); } catch (e) { /* older API */ }
		return true;
	}
	return false;
};

DazMcp.rotationOrder = function (bone) {
	var ro, s;
	// The DzRotationOrder enum, as Daz Studio 6 numbers it (checked on a real
	// Genesis 9: l_upperarm XYZ = 0, l_forearm XZY = 1, spine1 YZX = 3).
	var names = ["XYZ", "XZY", "YXZ", "YZX", "ZXY", "ZYX"];
	try { ro = bone.getRotationOrder(); } catch (e) { return null; }
	if (ro === undefined || ro === null) { return null; }
	if (typeof ro === "number") { return names[ro] || null; }
	// A DzRotationOrder prints as its order ("YZX"): trust that first.
	s = String(ro).toUpperCase().replace(/[^XYZ]/g, "");
	if (s.length === 3) { return s; }
	try { if (typeof ro.order === "number") { return names[ro.order] || null; } } catch (e2) { /* none */ }
	return null;
};


// ======================================================= stage 5 helpers ==
// Bodies and furniture: world-space meshes, body parts and simple collision
// tests, so a figure can be put on a seat or a bed and checked with numbers.
// getCachedGeom() is the mesh as Daz draws it now: posed, morphed and in
// world space (cm).

// Body part of a bone, for both Genesis 9 (l_thigh, spine1) and Genesis 8
// (lThighBend, abdomenLower) names. Null for bones that are not body parts.
DazMcp.bodyPart = function (boneName) {
	var n = String(boneName);
	var s = n.toLowerCase();
	var side = "";
	if (/^l_/.test(n) || /^l[A-Z]/.test(n)) { side = "left_"; } else if (/^r_/.test(n) || /^r[A-Z]/.test(n)) { side = "right_"; }
	if (/foot|toe|metatars|heel/.test(s)) { return side + "foot"; }
	if (/shin|calf/.test(s)) { return side + "shin"; }
	if (/thigh/.test(s)) { return side + "thigh"; }
	if (/forearm/.test(s)) { return side + "forearm"; }
	if (/upperarm|shldr/.test(s)) { return side + "upperarm"; }
	if (/hand|carpal|thumb|index|mid\d|ring|pinky/.test(s)) { return side + "hand"; }
	if (/collar|shoulder|clavicle/.test(s)) { return side + "shoulder"; }
	if (/head|eye|jaw|brow|nose|lip|cheek|tongue|teeth|lid|mouth|chin|squint|nasolabial|ear$|ear\d/.test(s)) { return "head"; }
	if (/neck/.test(s)) { return "neck"; }
	if (/abdomen|^spine1$|^spine2$/.test(s)) { return "abdomen"; }
	if (/chest|^spine3$|^spine4$|pectoral|breast/.test(s)) { return "chest"; }
	if (/pelvis|^hip$|glute|genital/.test(s)) { return "pelvis"; }
	return null;
};

// The big bones whose segments sort mesh points into body parts (fingers,
// toes and face bones are inside their hand, foot or head anyway).
DazMcp.isMajorBone = function (boneName, part) {
	var s = String(boneName).toLowerCase().replace(/^(l_|r_)/, "");
	if (!part) { return false; }
	if (/hand|foot|head/.test(part)) { return /^(l|r)?(hand|foot|head)$/.test(s); }
	return !/breast|pectoral|genital/.test(s);
};

// World end point of a bone (getEndPoint is in the unposed figure space).
DazMcp.boneEndWS = function (bone, fig) {
	var o = bone.getOrigin();
	var e = bone.getEndPoint();
	var p = bone.getWSPos();
	var s = 1;
	var d;
	try { s = fig.getScaleControl().getValue(); } catch (e0) { s = 1; }
	d = new DzVec3((e.x - o.x) * s, (e.y - o.y) * s, (e.z - o.z) * s);
	try { d = bone.getWSRot().multVec(d); } catch (e1) { /* unrotated */ }
	return [p.x + d.x, p.y + d.y, p.z + d.z];
};

DazMcp.bodySegments = function (fig) {
	var bones = DazMcp.bones(fig);
	var segs = [];
	var seen = {};
	var i, name, part, p;
	for (i = 0; i < bones.length; i++) {
		name = String(bones[i].getName());
		part = DazMcp.bodyPart(name);
		// a figure can list a bone more than once (Daz 6 does for Genesis 9)
		if (seen[name] || !DazMcp.isMajorBone(name, part)) { continue; }
		seen[name] = true;
		p = bones[i].getWSPos();
		segs.push({ bone: name, part: part, a: [p.x, p.y, p.z], b: DazMcp.boneEndWS(bones[i], fig) });
	}
	return segs;
};

DazMcp.segDist2 = function (x, y, z, a, b) {
	var dx = b[0] - a[0], dy = b[1] - a[1], dz = b[2] - a[2];
	var len2 = dx * dx + dy * dy + dz * dz;
	var t = len2 > 0 ? ((x - a[0]) * dx + (y - a[1]) * dy + (z - a[2]) * dz) / len2 : 0;
	if (t < 0) { t = 0; } else if (t > 1) { t = 1; }
	var px = a[0] + dx * t - x, py = a[1] + dy * t - y, pz = a[2] + dz * t - z;
	return px * px + py * py + pz * pz;
};

// The mesh as Daz draws it now. Daz rebuilds the cache lazily, so after a
// script moves or poses something the cache is stale until forceCacheUpdate.
DazMcp.cachedMesh = function (node) {
	var obj;
	try { obj = node.getObject(); } catch (e) { return null; }
	if (!obj) { return null; }
	try { obj.forceCacheUpdate(node); } catch (e1) { /* older API */ }
	try { return obj.getCachedGeom(); } catch (e2) { return null; }
};

// [min, max] of a rotation dial when Daz clamps it to limits, else null.
DazMcp.limitsOf = function (ctl) {
	try {
		if (ctl.isClamped && !ctl.isClamped()) { return null; }
		var lo = ctl.getMin(), hi = ctl.getMax();
		if (lo === undefined || hi === undefined || lo <= -3600 || hi >= 3600) { return null; }
		return [DazMcp.round(lo, 1), DazMcp.round(hi, 1)];
	} catch (e) { return null; }
};

// Lowest point of each body part asked for: {part: [x, y, z]}.
DazMcp.lowestPoints = function (fig, parts) {
	var pts = DazMcp.bodySamples(fig, { max: 15000, parts: parts });
	var low = {}, out = {}, i, part, r = DazMcp.round;
	for (i = 0; i < pts.x.length; i++) {
		part = pts.part[i];
		if (!low[part] || pts.y[i] < low[part][1]) { low[part] = [pts.x[i], pts.y[i], pts.z[i]]; }
	}
	for (part in low) {
		if (low.hasOwnProperty(part)) { out[part] = [r(low[part][0], 1), r(low[part][1], 1), r(low[part][2], 1)]; }
	}
	return out;
};

// Points of a figure's skin (every n-th vertex), each tagged with its body part.
//   opts.max    most points (default 20000)
//   opts.box    {min, max}: only points inside it
//   opts.parts  {part: true}: only points of these parts
//   opts.worn   also clothing and hair fitted to the figure (part "worn:<part>")
DazMcp.bodySamples = function (fig, opts) {
	opts = opts || {};
	var out = { x: [], y: [], z: [], part: [], total: 0 };
	var segs = DazMcp.bodySegments(fig);
	var meshes = [{ node: fig, worn: false }];
	var i, j, k, g, n, step, v, best, bestD, d, box = opts.box, list;
	if (opts.worn) {
		list = DazMcp.followers(fig);
		for (i = 0; i < list.length; i++) { if (list[i].isVisible()) { meshes.push({ node: list[i], worn: true }); } }
	}
	for (k = 0; k < meshes.length; k++) {
		g = DazMcp.cachedMesh(meshes[k].node);
		if (!g) { continue; }
		n = g.getNumVertices();
		out.total += n;
		step = Math.max(1, Math.ceil(n / (opts.max || 20000)));
		for (i = 0; i < n; i += step) {
			v = g.getVertex(i);
			if (box && (v.x < box.min[0] || v.x > box.max[0] || v.y < box.min[1] || v.y > box.max[1] ||
					v.z < box.min[2] || v.z > box.max[2])) { continue; }
			best = null;
			bestD = 1e30;
			for (j = 0; j < segs.length; j++) {
				d = DazMcp.segDist2(v.x, v.y, v.z, segs[j].a, segs[j].b);
				if (d < bestD) { bestD = d; best = segs[j].part; }
			}
			if (opts.parts && !opts.parts[best]) { continue; }
			if (meshes[k].worn) { best = "worn:" + (best || "other"); }
			out.x.push(v.x);
			out.y.push(v.y);
			out.z.push(v.z);
			out.part.push(best || "other");
		}
	}
	return out;
};

// The nodes whose meshes make up a prop: itself and the props under it.
DazMcp.propMeshNodes = function (node) {
	var out = [node];
	var kids, i, t;
	try { kids = node.getNodeChildren(true); } catch (e) { kids = []; }
	for (i = 0; i < kids.length; i++) {
		t = DazMcp.nodeType(kids[i]);
		if ((t === "prop" || t === "group") && kids[i].isVisible()) { out.push(kids[i]); }
	}
	return out;
};

// World triangles of nodes, as flat arrays: 9 coordinates per triangle, its
// unit normal (from the winding: outward on a well made mesh) and its area.
//   box  {min, max}: keep only triangles that touch it
DazMcp.meshTriangles = function (nodes, box) {
	var t = { p: [], n: [], area: [], count: 0, faces: 0 };
	var k, g, i, f, q, v, nv, vx3 = [], out = [];
	var add = function (ia, ib, ic) {
		if (box && (out[ia] & out[ib] & out[ic])) { return; }
		var a = ia * 3, b = ib * 3, c = ic * 3, P = vx3;
		var ux = P[b] - P[a], uy = P[b + 1] - P[a + 1], uz = P[b + 2] - P[a + 2];
		var vx = P[c] - P[a], vy = P[c + 1] - P[a + 1], vz = P[c + 2] - P[a + 2];
		var nx = uy * vz - uz * vy, ny = uz * vx - ux * vz, nz = ux * vy - uy * vx;
		var len = Math.sqrt(nx * nx + ny * ny + nz * nz);
		if (len < 1e-9) { return; }
		t.p.push(P[a], P[a + 1], P[a + 2], P[b], P[b + 1], P[b + 2], P[c], P[c + 1], P[c + 2]);
		t.n.push(nx / len, ny / len, nz / len);
		t.area.push(len / 2);
		t.count++;
	};
	for (k = 0; k < nodes.length; k++) {
		g = DazMcp.cachedMesh(nodes[k]);
		if (!g || !g.getNumFacets) { continue; }
		// one read per vertex; out[] holds which sides of the box it is past
		// (a triangle whose 3 corners share a side is outside the box)
		nv = g.getNumVertices();
		vx3 = [];
		out = [];
		for (i = 0; i < nv; i++) {
			v = g.getVertex(i);
			vx3.push(v.x, v.y, v.z);
			if (box) {
				out.push((v.x < box.min[0] ? 1 : 0) | (v.x > box.max[0] ? 2 : 0) | (v.y < box.min[1] ? 4 : 0) |
					(v.y > box.max[1] ? 8 : 0) | (v.z < box.min[2] ? 16 : 0) | (v.z > box.max[2] ? 32 : 0));
			}
		}
		for (i = 0; i < g.getNumFacets(); i++) {
			f = g.getFacet(i);
			q = f.vertIdx4;
			t.faces++;
			add(f.vertIdx1, f.vertIdx2, f.vertIdx3);
			if (q !== undefined && q !== null && q >= 0) { add(f.vertIdx1, f.vertIdx3, q); }
		}
	}
	return t;
};

// A 2D grid of triangles for lines along one axis (0 = X, 1 = Y, 2 = Z).
DazMcp.triGrid = function (tris, axis, cell) {
	var u = axis === 0 ? 1 : 0;
	var v = axis === 2 ? 1 : 2;
	var grid = { tris: tris, axis: axis, u: u, v: v, cell: cell || 4, cells: {} };
	var i, o, umin, umax, vmin, vmax, a, b, key;
	for (i = 0; i < tris.count; i++) {
		if (Math.abs(tris.n[i * 3 + axis]) < 1e-4) { continue; }
		o = i * 9;
		umin = Math.floor(Math.min(tris.p[o + u], tris.p[o + 3 + u], tris.p[o + 6 + u]) / grid.cell);
		umax = Math.floor(Math.max(tris.p[o + u], tris.p[o + 3 + u], tris.p[o + 6 + u]) / grid.cell);
		vmin = Math.floor(Math.min(tris.p[o + v], tris.p[o + 3 + v], tris.p[o + 6 + v]) / grid.cell);
		vmax = Math.floor(Math.max(tris.p[o + v], tris.p[o + 3 + v], tris.p[o + 6 + v]) / grid.cell);
		for (a = umin; a <= umax; a++) {
			for (b = vmin; b <= vmax; b++) {
				key = a + "," + b;
				if (!grid.cells[key]) { grid.cells[key] = []; }
				grid.cells[key].push(i);
			}
		}
	}
	return grid;
};

// Where the axis line through point p crosses the triangles: [{t, s, i}] with
// t the coordinate along the axis and s the sign of the normal along it.
DazMcp.gridHits = function (grid, p) {
	var tris = grid.tris, ax = grid.axis, u = grid.u, v = grid.v;
	var list = grid.cells[Math.floor(p[u] / grid.cell) + "," + Math.floor(p[v] / grid.cell)];
	var hits = [];
	var k, i, o, au, av, bu, bv, cu, cv, d, w1, w2, w0;
	if (!list) { return hits; }
	for (k = 0; k < list.length; k++) {
		i = list[k];
		o = i * 9;
		au = tris.p[o + u]; av = tris.p[o + v];
		bu = tris.p[o + 3 + u]; bv = tris.p[o + 3 + v];
		cu = tris.p[o + 6 + u]; cv = tris.p[o + 6 + v];
		d = (bv - cv) * (au - cu) + (cu - bu) * (av - cv);
		if (Math.abs(d) < 1e-12) { continue; }
		w0 = ((bv - cv) * (p[u] - cu) + (cu - bu) * (p[v] - cv)) / d;
		w1 = ((cv - av) * (p[u] - cu) + (au - cu) * (p[v] - cv)) / d;
		w2 = 1 - w0 - w1;
		if (w0 < -1e-6 || w1 < -1e-6 || w2 < -1e-6) { continue; }
		hits.push({ t: w0 * tris.p[o + ax] + w1 * tris.p[o + 3 + ax] + w2 * tris.p[o + 6 + ax],
			s: tris.n[i * 3 + ax] > 0 ? 1 : -1, i: i });
	}
	return hits;
};

// Is p inside the mesh? Along each axis, the nearest surface on each side says
// "inside" when we see its back. Returns null (outside) or {depth, axis, dir}:
// the easiest way out, dir +1 or -1 along the axis. Bodies come down onto
// things, so up counts as shorter and down as longer than it is: a hip that
// sank 3.5 cm into a 5 cm seat should go up, not out through the bottom.
DazMcp.insideTest = function (grids, p, maxDepth) {
	var votesIn = 0, votesOut = 0, best = null;
	var g, hits, k, up, down, h, said, ax, w;
	for (g = 0; g < grids.length; g++) {
		ax = grids[g].axis;
		hits = DazMcp.gridHits(grids[g], p);
		up = null;
		down = null;
		for (k = 0; k < hits.length; k++) {
			h = hits[k];
			if (h.t >= p[ax]) { if (!up || h.t < up.t) { up = h; } } else if (!down || h.t > down.t) { down = h; }
		}
		said = 0;
		if (up) {
			said += up.s > 0 ? 1 : -1;
			h = up.t - p[ax];
			w = h * (ax === 1 ? 0.6 : 1);
			if (up.s > 0 && h <= maxDepth && (!best || w < best.w)) { best = { depth: h, axis: ax, dir: 1, w: w }; }
		}
		if (down) {
			said += down.s < 0 ? 1 : -1;
			h = p[ax] - down.t;
			w = h * (ax === 1 ? 2 : 1);
			if (down.s < 0 && h <= maxDepth && (!best || w < best.w)) { best = { depth: h, axis: ax, dir: -1, w: w }; }
		}
		if (said > 0) { votesIn++; } else if (said < 0) { votesOut++; }
	}
	return votesIn > votesOut && best ? best : null;
};

// Distance from p down to the nearest upward-facing surface below it, or null.
DazMcp.gapBelow = function (gridY, p, maxGap) {
	var hits = DazMcp.gridHits(gridY, p);
	var best = null, k, d;
	for (k = 0; k < hits.length; k++) {
		if (hits[k].s > 0 && hits[k].t <= p[1] + 0.01) {
			d = p[1] - hits[k].t;
			if (d <= maxGap && (best === null || d < best)) { best = d; }
		}
	}
	return best;
};

// A node's world rotation applied to the vector v.
DazMcp.nodeDir = function (node, v) {
	var r;
	try { r = node.getWSRot().multVec(new DzVec3(v[0], v[1], v[2])); return [r.x, r.y, r.z]; } catch (e) { /* by angle */ }
	var yaw = node.getYRotControl().getValue() * Math.PI / 180;
	return [v[0] * Math.cos(yaw) + v[2] * Math.sin(yaw), v[1], -v[0] * Math.sin(yaw) + v[2] * Math.cos(yaw)];
};

// Flat surfaces to sit, lie or stand on: upward-facing triangles at one
// height, split into pieces that touch in X/Z.
//   opts.min_area (cm2, default 150), opts.max_tilt (degrees, default 20)
DazMcp.supportSurfaces = function (node, opts) {
	opts = opts || {};
	var tris = DazMcp.meshTriangles(DazMcp.propMeshNodes(node), opts.box || null);
	var cosT = Math.cos((opts.max_tilt === undefined ? 20 : opts.max_tilt) * Math.PI / 180);
	var minArea = opts.min_area === undefined ? 150 : opts.min_area;
	var bins = {}, keys = [], i, o, cy, key, k, clusters = [], cur = null, last = null;
	for (i = 0; i < tris.count; i++) {
		if (tris.n[i * 3 + 1] < cosT) { continue; }
		o = i * 9;
		cy = (tris.p[o + 1] + tris.p[o + 4] + tris.p[o + 7]) / 3;
		key = Math.floor(cy);
		if (!bins[key]) { bins[key] = []; keys.push(key); }
		bins[key].push(i);
	}
	keys.sort(function (a, b) { return a - b; });
	for (k = 0; k < keys.length; k++) {
		if (cur && keys[k] - last <= 2) { cur = cur.concat(bins[keys[k]]); } else {
			if (cur) { clusters.push(cur); }
			cur = bins[keys[k]].slice();
		}
		last = keys[k];
	}
	if (cur) { clusters.push(cur); }

	var ax = DazMcp.nodeDir(node, [1, 0, 0]);
	var az = DazMcp.nodeDir(node, [0, 0, 1]);
	var surfaces = [];
	var c, j, pieces;
	for (c = 0; c < clusters.length; c++) {
		pieces = DazMcp._splitPieces(tris, clusters[c], 5);
		for (j = 0; j < pieces.length; j++) { surfaces.push(DazMcp._surfaceInfo(tris, pieces[j], ax, az)); }
	}
	surfaces = surfaces.filter(function (s) { return s.area >= minArea; });
	surfaces.sort(function (p1, p2) { return p2.area - p1.area; });
	for (i = 0; i < surfaces.length && i < 12; i++) { DazMcp._surfaceFront(tris, surfaces[i], ax, az); }
	return { surfaces: surfaces, tris: tris };
};

// Splits triangles into groups that touch, over a grid of `cell` cm in X/Z.
DazMcp._splitPieces = function (tris, list, cell) {
	var cellOf = {}, owner = {}, pieces = [], keys = [];
	var j, i, o, key, piece, stack, idx, a, x, z, nb, m, x0, x1, z0, z1;
	for (j = 0; j < list.length; j++) {
		i = list[j];
		o = i * 9;
		x0 = Math.floor(Math.min(tris.p[o], tris.p[o + 3], tris.p[o + 6]) / cell);
		x1 = Math.floor(Math.max(tris.p[o], tris.p[o + 3], tris.p[o + 6]) / cell);
		z0 = Math.floor(Math.min(tris.p[o + 2], tris.p[o + 5], tris.p[o + 8]) / cell);
		z1 = Math.floor(Math.max(tris.p[o + 2], tris.p[o + 5], tris.p[o + 8]) / cell);
		for (x = x0; x <= x1; x++) {
			for (z = z0; z <= z1; z++) {
				key = x + "," + z;
				if (!cellOf[key]) { cellOf[key] = []; keys.push(key); }
				cellOf[key].push(i);
			}
		}
	}
	for (m = 0; m < keys.length; m++) {
		key = keys[m];
		if (owner[key] !== undefined) { continue; }
		piece = {};
		owner[key] = pieces.length;
		stack = [key];
		while (stack.length) {
			idx = stack.pop();
			for (j = 0; j < cellOf[idx].length; j++) { piece[cellOf[idx][j]] = true; }
			a = idx.split(",");
			for (x = -1; x <= 1; x++) {
				for (z = -1; z <= 1; z++) {
					nb = (parseInt(a[0], 10) + x) + "," + (parseInt(a[1], 10) + z);
					if (cellOf[nb] && owner[nb] === undefined) { owner[nb] = pieces.length; stack.push(nb); }
				}
			}
		}
		pieces.push(piece);
	}
	return pieces;
};

DazMcp._surfaceInfo = function (tris, piece, ax, az) {
	var area = 0, sy = 0, sx = 0, sz = 0, ymin = 1e30, ymax = -1e30;
	var min = [1e30, 1e30], max = [-1e30, -1e30], lx = [1e30, -1e30], lz = [1e30, -1e30];
	var list = [], key, i, o, k, ar, x, y, z, dx, dz;
	for (key in piece) {
		if (!piece.hasOwnProperty(key)) { continue; }
		i = parseInt(key, 10);
		list.push(i);
		o = i * 9;
		ar = tris.area[i];
		area += ar;
		for (k = 0; k < 3; k++) {
			x = tris.p[o + k * 3]; y = tris.p[o + k * 3 + 1]; z = tris.p[o + k * 3 + 2];
			sx += x * ar / 3; sy += y * ar / 3; sz += z * ar / 3;
			if (y < ymin) { ymin = y; }
			if (y > ymax) { ymax = y; }
			if (x < min[0]) { min[0] = x; }
			if (x > max[0]) { max[0] = x; }
			if (z < min[1]) { min[1] = z; }
			if (z > max[1]) { max[1] = z; }
			dx = x * ax[0] + z * ax[2];
			dz = x * az[0] + z * az[2];
			if (dx < lx[0]) { lx[0] = dx; }
			if (dx > lx[1]) { lx[1] = dx; }
			if (dz < lz[0]) { lz[0] = dz; }
			if (dz > lz[1]) { lz[1] = dz; }
		}
	}
	return { tris: list, area: area, y: sy / area, y_min: ymin, y_max: ymax,
		center: [sx / area, sy / area, sz / area], xz_min: min, xz_max: max,
		size: [lx[1] - lx[0], lz[1] - lz[0]] };
};

// A seat has a back: geometry rising above the surface on one side. front is
// the horizontal direction away from it, or null when there is no back.
DazMcp._surfaceFront = function (tris, s, ax, az) {
	var pad = 8, sx = 0, sz = 0, w = 0, i, o, k, cx, cy, cz, ar, d, len, reach;
	for (i = 0; i < tris.count; i++) {
		o = i * 9;
		cx = (tris.p[o] + tris.p[o + 3] + tris.p[o + 6]) / 3;
		cy = (tris.p[o + 1] + tris.p[o + 4] + tris.p[o + 7]) / 3;
		cz = (tris.p[o + 2] + tris.p[o + 5] + tris.p[o + 8]) / 3;
		if (cy < s.y_max + 8 || cy > s.y + 120) { continue; }
		if (cx < s.xz_min[0] - pad || cx > s.xz_max[0] + pad || cz < s.xz_min[1] - pad || cz > s.xz_max[1] + pad) { continue; }
		ar = tris.area[i];
		sx += cx * ar; sz += cz * ar; w += ar;
	}
	s.front = null;
	if (w < s.area * 0.15) { return; }
	d = [sx / w - s.center[0], sz / w - s.center[2]];
	len = Math.sqrt(d[0] * d[0] + d[1] * d[1]);
	if (len < 0.15 * Math.min(s.size[0], s.size[1])) { return; }
	s.front = [-d[0] / len, 0, -d[1] / len];
	// furniture is modeled square to its own axes: snap to the nearest one
	var axes = [ax, az, [-ax[0], 0, -ax[2]], [-az[0], 0, -az[2]]], bestDot = 0, bestAx = null, dot, hl;
	for (k = 0; k < 4; k++) {
		hl = Math.sqrt(axes[k][0] * axes[k][0] + axes[k][2] * axes[k][2]);
		if (hl < 0.5) { continue; }
		dot = (axes[k][0] * s.front[0] + axes[k][2] * s.front[2]) / hl;
		if (dot > bestDot) { bestDot = dot; bestAx = [axes[k][0] / hl, 0, axes[k][2] / hl]; }
	}
	if (bestAx && bestDot > Math.cos(30 * Math.PI / 180)) { s.front = bestAx; }
	reach = 0;
	for (k = 0; k < s.tris.length; k++) {
		o = s.tris[k] * 9;
		for (i = 0; i < 3; i++) {
			d = -((tris.p[o + i * 3] - s.center[0]) * s.front[0] + (tris.p[o + i * 3 + 2] - s.center[2]) * s.front[2]);
			if (d > reach) { reach = d; }
		}
	}
	s.back_reach = reach;
};

DazMcp.surfaceOut = function (s, index) {
	var r = DazMcp.round;
	var out = { index: index, height: r(s.y, 1), height_range: [r(s.y_min, 1), r(s.y_max, 1)], area_cm2: Math.round(s.area),
		size_cm: [r(s.size[0], 1), r(s.size[1], 1)], center: [r(s.center[0], 1), r(s.center[1], 1), r(s.center[2], 1)],
		bounds_xz: { min: [r(s.xz_min[0], 1), r(s.xz_min[1], 1)], max: [r(s.xz_max[0], 1), r(s.xz_max[1], 1)] } };
	if (s.front) {
		out.front = [r(s.front[0], 3), 0, r(s.front[2], 3)];
		out.facing_yaw = r(Math.atan2(s.front[0], s.front[2]) * 180 / Math.PI, 1);
		out.back_edge_cm = r(s.back_reach, 1);
	}
	return out;
};

DazMcp.padBox = function (box, d) {
	return { min: [box.min[0] - d, box.min[1] - d, box.min[2] - d], max: [box.max[0] + d, box.max[1] + d, box.max[2] + d] };
};

// Which way the figure looks and where its left is (Genesis faces +Z, its
// left side is +X).
DazMcp.figureFrame = function (fig) {
	return { forward: DazMcp.nodeDir(fig, [0, 0, 1]), left: DazMcp.nodeDir(fig, [1, 0, 0]) };
};

// "up", "back", "left"... for a world direction, as the figure sees it.
DazMcp.dirWord = function (frame, v) {
	var f = v[0] * frame.forward[0] + v[1] * frame.forward[1] + v[2] * frame.forward[2];
	var l = v[0] * frame.left[0] + v[1] * frame.left[1] + v[2] * frame.left[2];
	var u = v[1];
	if (Math.abs(u) >= Math.abs(f) && Math.abs(u) >= Math.abs(l)) { return u > 0 ? "up" : "down"; }
	if (Math.abs(f) >= Math.abs(l)) { return f > 0 ? "forward" : "back"; }
	return l > 0 ? "left" : "right";
};

DazMcp._trisBox = function (tris) {
	var min = [1e30, 1e30, 1e30], max = [-1e30, -1e30, -1e30], i, k;
	for (i = 0; i < tris.p.length; i += 3) {
		for (k = 0; k < 3; k++) {
			if (tris.p[i + k] < min[k]) { min[k] = tris.p[i + k]; }
			if (tris.p[i + k] > max[k]) { max[k] = tris.p[i + k]; }
		}
	}
	return { min: min, max: max };
};

// Collision report of a figure against other nodes (props or figures): per
// body part, how deep it goes into them and which way is out, or how far it
// floats above the surface under it.
//   opts.max_depth  deepest overlap that counts (cm, default 15)
//   opts.worn       also test clothing and hair
//   opts.samples    most skin points (default 20000)
//   opts.tolerance  overlap that still counts as resting on it (cm, default 1)
DazMcp.fitCheck = function (fig, against, opts) {
	opts = opts || {};
	var maxDepth = opts.max_depth || 15;
	var r = DazMcp.round;
	var fbox = DazMcp.bboxOf([fig]);
	var frame = DazMcp.figureFrame(fig);
	var report = { figure: fig.getLabel(), against: [], overlapping: false, parts: {}, touching: [] };
	var a, nodes, tris, grids, tb, pts, i, p, hit, part, rec, gap, axisV, name, word, wbest;
	if (!fbox) { throw DazMcp.fail("no_geometry", fig.getLabel() + " has no mesh to test."); }
	pts = DazMcp.bodySamples(fig, { max: opts.samples || 20000, worn: opts.worn });
	for (a = 0; a < against.length; a++) {
		nodes = DazMcp.inherits(against[a], "DzSkeleton") ? [against[a]] : DazMcp.propMeshNodes(against[a]);
		tris = DazMcp.meshTriangles(nodes, DazMcp.padBox(fbox, 2));
		report.against.push({ node: against[a].getLabel(), triangles_near: tris.count });
		if (!tris.count) { continue; }
		grids = [DazMcp.triGrid(tris, 1, 4), DazMcp.triGrid(tris, 0, 4), DazMcp.triGrid(tris, 2, 4)];
		tb = DazMcp._trisBox(tris);
		for (i = 0; i < pts.x.length; i++) {
			p = [pts.x[i], pts.y[i], pts.z[i]];
			if (p[0] < tb.min[0] - 30 || p[0] > tb.max[0] + 30 || p[1] < tb.min[1] - 30 || p[1] > tb.max[1] + 30 ||
				p[2] < tb.min[2] - 30 || p[2] > tb.max[2] + 30) { continue; }
			part = pts.part[i];
			rec = report.parts[part];
			hit = (p[0] >= tb.min[0] && p[0] <= tb.max[0] && p[1] >= tb.min[1] && p[1] <= tb.max[1] &&
				p[2] >= tb.min[2] && p[2] <= tb.max[2]) ? DazMcp.insideTest(grids, p, maxDepth) : null;
			if (hit) {
				if (!rec) { rec = report.parts[part] = {}; }
				rec.inside_points = (rec.inside_points || 0) + 1;
				// tally the ways out; the part goes the way most of its depth says
				axisV = [0, 0, 0];
				axisV[hit.axis] = hit.dir;
				word = DazMcp.dirWord(frame, axisV);
				if (!rec._ways) { rec._ways = {}; }
				if (!rec._ways[word]) { rec._ways[word] = { sum: 0, max: 0, point: null, world: axisV, into: against[a].getLabel() }; }
				rec._ways[word].sum += hit.depth;
				if (hit.depth >= rec._ways[word].max) {
					rec._ways[word].max = hit.depth;
					rec._ways[word].point = [r(p[0], 1), r(p[1], 1), r(p[2], 1)];
				}
				continue;
			}
			gap = DazMcp.gapBelow(grids[0], p, 30);
			if (gap !== null) {
				if (!rec) { rec = report.parts[part] = {}; }
				if (rec.gap_below_cm === undefined || gap < rec.gap_below_cm) { rec.gap_below_cm = gap; rec.above = against[a].getLabel(); }
			}
		}
	}
	var hints = [], up = 0, side = [];
	var tol = opts.tolerance === undefined || opts.tolerance === null ? 1 : opts.tolerance;
	for (name in report.parts) {
		if (!report.parts.hasOwnProperty(name)) { continue; }
		rec = report.parts[name];
		if (rec.gap_below_cm !== undefined) { rec.gap_below_cm = r(rec.gap_below_cm, 1); }
		if (rec._ways) {
			wbest = null;
			for (word in rec._ways) {
				if (rec._ways.hasOwnProperty(word) && (!wbest || rec._ways[word].sum > rec._ways[wbest].sum)) { wbest = word; }
			}
			rec.max_depth_cm = rec._ways[wbest].max;
			rec.way_out = wbest;
			rec.way_out_world = rec._ways[wbest].world;
			rec.deepest_point = rec._ways[wbest].point;
			rec.into = rec._ways[wbest].into;
			delete rec._ways;
		}
		if (rec.max_depth_cm !== undefined) {
			rec.max_depth_cm = r(rec.max_depth_cm, 1);
			if (rec.max_depth_cm > tol) {
				report.overlapping = true;
				if (rec.way_out === "up") { up = Math.max(up, rec.max_depth_cm); } else { side.push(name + " " + rec.max_depth_cm + " cm (way out: " + rec.way_out + ")"); }
				continue;
			}
		}
		if (rec.max_depth_cm !== undefined || rec.gap_below_cm <= 1.5) { report.touching.push(name); }
	}
	if (up > 0) { hints.push("Parts sink up to " + up + " cm into the surface under them: raise the figure about that much, or pose those parts to rest on top."); }
	if (side.length) { hints.push("Parts pass through the side of something: " + side.join("; ") + ". Move the figure that way or pose those parts away."); }
	if (!report.overlapping && !report.touching.length) { hints.push("Nothing touches: the figure floats above or stands apart from these nodes."); }
	report.hints = hints;
	return report;
};

// ======================================================== modal dialogs ==
// A modal dialog stops the script until someone clicks it, and the agent
// cannot see it. These helpers answer the known ones in advance.

// Loads a content file with ContentMgr.openFile (merge). Daz Studio 6 asks
// "Character Load Options" (new figure or apply to the selected one) when a
// character preset loads with a figure selected; answer it through the same
// settings the dialog saves, and put the user's own choice back afterwards.
// asPreset: true applies a character to the selected figure, false adds one.
DazMcp.openContent = function (path, asPreset) {
	var prefs = new DzAppSettings();
	var oldShow = prefs.getStringValue("DSONCharacterShowLoadDlg", "");
	var oldAsPreset = prefs.getStringValue("DSONCharacterLoadAsPreset", "");
	prefs.setStringValue("DSONCharacterShowLoadDlg", "false");
	prefs.setStringValue("DSONCharacterLoadAsPreset", asPreset ? "true" : "false");
	try {
		return App.getContentMgr().openFile(path, true);
	} finally {
		if (oldShow === "") { prefs.removeValue("DSONCharacterShowLoadDlg"); }
		else { prefs.setStringValue("DSONCharacterShowLoadDlg", oldShow); }
		if (oldAsPreset === "") { prefs.removeValue("DSONCharacterLoadAsPreset"); }
		else { prefs.setStringValue("DSONCharacterLoadAsPreset", oldAsPreset); }
	}
};

// Removes a file that is about to be written, so Daz does not ask "The file
// already exists. Do you want to overwrite it?" (the render manager does).
// Throws "exists" when overwrite is false.
DazMcp.clearTarget = function (path, overwrite) {
	if (!DazMcp.fileExists(path)) { return false; }
	if (!overwrite) {
		throw DazMcp.fail("exists", "A file already exists at " + path + ". Pass overwrite=true to replace it.");
	}
	var f = new DzFile(path);
	if (!f.remove() && DazMcp.fileExists(path)) {
		throw DazMcp.fail("exists", "Could not replace " + path + " (is it open in another program?).");
	}
	return true;
};
