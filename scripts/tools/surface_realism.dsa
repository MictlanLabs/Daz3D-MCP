// Tool: surface_realism
// Takes the "plastic" look off a render, surface by surface.
//
// Figures: many character presets stack two specular layers on the skin (the
// Glossy layer AND the Dual Lobe Specular), which reads as wet plastic under
// studio lights. The skin surfaces get one soft dual-lobe specular instead.
// Props: models imported from FBX/OBJ come in with Daz's small "Physically
// Based Rendering" shader (base color, metal, roughness, normal map only), so
// every surface has the same flat sheen. Each one is rebuilt as Iray Uber, with
// the finish its name suggests (leather, cloth, plastic, chrome, car paint,
// rubber, glass, wood...).
//
// args:
//   node        (string, required) figure, clothing or prop label
//   skin        ("natural" | "matte" | "oily" | "none", default "natural") skin finish on figures
//   upgrade     (bool, default true) rebuild "Physically Based Rendering" surfaces as Iray Uber
//   children    (bool, default true) also the props parented to node (cars, sets made of many parts)
//   worn        (bool, default false) also what a figure wears (clothing, hair)
//   dry_run     (bool, default false) only report what would change

var SKIN_FINISH = {
	natural: { glossy: 0.06, dual: 0.4, lobe1: 0.55, lobe2: 0.38 },
	matte: { glossy: 0.0, dual: 0.25, lobe1: 0.65, lobe2: 0.5 },
	oily: { glossy: 0.15, dual: 0.55, lobe1: 0.45, lobe2: 0.3 }
};

// Surface names that are never skin even when they scatter light.
var NOT_SKIN = /(eye|cornea|moisture|sclera|iris|pupil|tear|teeth|tongue|mouth|nail|lash|brow|socket|gum)/i;

// [pattern, finish] tried in order on the surface name.
var FINISHES = [
	[/(glass|window|windshield|lens|visor)/i, "glass"],
	[/(chrome|mirror)/i, "chrome"],
	[/(paint|^body$|carpaint|car_paint|bodywork)/i, "paint"],
	[/(leather|vinyl)/i, "leather"],
	[/(cloth|fabric|headliner|carpet|textile|seat|cushion|mottled|felt|wool)/i, "cloth"],
	[/(tire|tyre|rubber|rezina|weatherstrip)/i, "rubber"],
	[/(rim|wheel|metal|steel|alu|iron|met$|metall)/i, "metal"],
	[/(light|lamp|reflector|lens)/i, "light"],
	[/(wood|timber|plank)/i, "wood"],
	[/(plastic|dash|trim|frame|black|matte|misc|solid|badge|emblem|stitch|gauge|button)/i, "plastic"]
];

var PRESETS = {
	glass: { "Glossy Layered Weight": 1, "Glossy Roughness": 0.03, "Refraction Weight": 1, "Refraction Index": 1.5,
		"Base Color": [1, 1, 1] },
	chrome: { "Metallicity": 1, "Base Color": [0.88, 0.88, 0.9], "Glossy Roughness": 0.08 },
	paint: { "Glossy Layered Weight": 0.6, "Glossy Roughness": 0.3, "Top Coat Weight": 1, "Top Coat Roughness": 0.04 },
	leather: { "Glossy Layered Weight": 0.45, "Glossy Roughness": 0.45 },
	cloth: { "Glossy Layered Weight": 0.06, "Glossy Roughness": 0.9 },
	rubber: { "Glossy Layered Weight": 0.12, "Glossy Roughness": 0.8 },
	metal: { "Metallicity": 0.75, "Glossy Roughness": 0.32 },
	light: { "Glossy Layered Weight": 0.6, "Glossy Roughness": 0.2 },
	wood: { "Glossy Layered Weight": 0.25, "Glossy Roughness": 0.6 },
	plastic: { "Glossy Layered Weight": 0.3, "Glossy Roughness": 0.55 },
	generic: { "Glossy Layered Weight": 0.3 }
};

function finishOf(names) {
	for (var i = 0; i < FINISHES.length; i++) {
		for (var j = 0; j < names.length; j++) {
			if (FINISHES[i][0].test(names[j])) { return FINISHES[i][1]; }
		}
	}
	return "generic";
}

function num(m, label) {
	var p = DazMcp.findProp(m, [label]);
	return p ? p.getValue() : null;
}

function setNum(m, label, value, changes, dry) {
	var p = DazMcp.findProp(m, [label]);
	if (!p) { return; }
	var before = p.getValue();
	if (Math.abs(before - value) < 1e-4) { return; }
	if (!dry) { p.setValue(value); }
	changes[label] = [DazMcp.round(before, 3), value];
}

function isSkin(m) {
	var name = String(m.getLabel()) + " " + String(m.getName());
	if (NOT_SKIN.test(name)) { return false; }
	if (String(m.getMaterialName()).indexOf("Uber") < 0 && String(m.getMaterialName()).indexOf("PBRSkin") < 0) { return false; }
	var t = num(m, "Translucency Weight");
	var dual = num(m, "Dual Lobe Specular Weight");
	return (t !== null && t > 0.15) || (dual !== null && dual > 0 && /(face|head|torso|body|arm|leg|ear|lip|neck|hand|foot|feet|genital|skin)/i.test(name));
}

function fixSkin(node, finish, dry, out) {
	var f = SKIN_FINISH[finish];
	var shape;
	try { shape = node.getObject().getCurrentShape(); } catch (e) { return; }
	if (!shape) { return; }
	for (var i = 0; i < shape.getNumMaterials(); i++) {
		var m = shape.getMaterial(i);
		if (!isSkin(m)) { continue; }
		var changes = {};
		var glossy = num(m, "Glossy Layered Weight");
		var dual = num(m, "Dual Lobe Specular Weight");
		// Two specular layers stacked: keep the dual lobe, nearly drop the glossy one.
		if (glossy !== null && glossy > f.glossy) { setNum(m, "Glossy Layered Weight", f.glossy, changes, dry); }
		if (dual !== null) {
			setNum(m, "Dual Lobe Specular Weight", f.dual, changes, dry);
			setNum(m, "Specular Lobe 1 Roughness", f.lobe1, changes, dry);
			setNum(m, "Specular Lobe 2 Roughness", f.lobe2, changes, dry);
		} else if (glossy !== null) {
			// no dual lobe on this shader: one soft glossy layer instead
			setNum(m, "Glossy Layered Weight", Math.max(f.glossy, 0.25), changes, dry);
			setNum(m, "Glossy Roughness", Math.max(f.lobe1, 0.5), changes, dry);
		}
		out.push({ node: node.getLabel(), surface: m.getLabel(), kind: "skin", finish: finish, changed: changes });
	}
}

function setPreset(m, preset) {
	for (var label in preset) {
		if (!preset.hasOwnProperty(label)) { continue; }
		var p = DazMcp.findProp(m, [label]);
		if (!p) { continue; }
		var v = preset[label];
		if (DazMcp.isArray(v)) { p.setColorValue(new Color(Math.round(v[0] * 255), Math.round(v[1] * 255), Math.round(v[2] * 255))); }
		else { p.setValue(v); }
	}
}

function upgradeNode(node, dry, out) {
	var shape;
	try { shape = node.getObject().getCurrentShape(); } catch (e) { return; }
	if (!shape) { return; }
	for (var i = 0; i < shape.getNumMaterials(); i++) {
		var old = shape.getMaterial(i);
		if (String(old.getMaterialName()) !== "Physically Based Rendering") { continue; }
		var finish = finishOf([String(old.getName()), String(old.getLabel())]);
		var entry = { node: node.getLabel(), surface: old.getLabel(), kind: "upgrade", finish: finish };
		out.push(entry);
		if (dry) { continue; }
		var u = new DzUberIrayMaterial();
		u.setName(old.getName());
		u.setLabel(old.getLabel());
		var src = DazMcp.findProp(old, ["Diffuse Color"]);
		var dst = DazMcp.findProp(u, ["Diffuse Color"]);
		if (src && dst) {
			dst.setColorValue(src.getColorValue());
			if (src.getMapValue()) { dst.setMap(src.getMapValue()); }
		}
		var metal = DazMcp.findProp(old, ["Metallicity", "Metallic Weight"]);
		var umetal = DazMcp.findProp(u, ["Metallicity", "Metallic Weight"]);
		if (metal && umetal) {
			umetal.setValue(metal.getValue());
			if (metal.getMapValue && metal.getMapValue()) { umetal.setMap(metal.getMapValue()); }
		}
		var rough = DazMcp.findProp(old, ["Roughness", "Glossy Roughness"]);
		var urough = DazMcp.findProp(u, ["Glossy Roughness"]);
		if (rough && urough) {
			urough.setValue(Math.min(0.9, rough.getValue()));
			if (rough.getMapValue && rough.getMapValue()) { urough.setMap(rough.getMapValue()); }
		}
		var nrm = DazMcp.findProp(old, ["Normal Map"]);
		var unrm = DazMcp.findProp(u, ["Normal Map"]);
		if (nrm && unrm && nrm.getMapValue && nrm.getMapValue()) { unrm.setMap(nrm.getMapValue()); }
		setNum(u, "Glossy Layered Weight", 0.3, {}, false);
		setPreset(u, PRESETS[finish]);
		shape.replaceMaterial(old, u);
	}
}

function dazmcpTool(args) {
	var node = DazMcp.requireNode(args.node, "node");
	var skin = args.skin || "natural";
	if (skin !== "none" && !SKIN_FINISH[skin]) {
		throw DazMcp.fail("bad_args", "skin must be natural, matte, oily or none.");
	}
	var dry = args.dry_run === true;
	var upgrade = args.upgrade !== false;
	var nodes = [node];
	var i, kids, t;
	if (args.children !== false) {
		try { kids = node.getNodeChildren(true); } catch (e) { kids = []; }
		for (i = 0; i < kids.length; i++) {
			t = DazMcp.nodeType(kids[i]);
			if (t === "prop" || t === "group") { nodes.push(kids[i]); }
		}
	}
	var type = DazMcp.nodeType(node);
	if (args.worn === true && (type === "figure" || type === "fitted_figure")) {
		nodes = nodes.concat(DazMcp.followers(node));
	}
	var out = [];
	for (i = 0; i < nodes.length; i++) {
		t = DazMcp.nodeType(nodes[i]);
		if (skin !== "none" && (t === "figure" || t === "fitted_figure")) { fixSkin(nodes[i], skin, dry, out); }
		if (upgrade) { upgradeNode(nodes[i], dry, out); }
	}
	var counts = {};
	for (i = 0; i < out.length; i++) {
		counts[out[i].kind + ":" + out[i].finish] = (counts[out[i].kind + ":" + out[i].finish] || 0) + 1;
	}
	var res = { node: node.getLabel(), dry_run: dry, surfaces: out.length, counts: counts, changes: out.slice(0, 60) };
	if (!out.length) {
		res.note = "Nothing to change: no skin surfaces with a stacked specular and no \"Physically Based " +
			"Rendering\" surfaces were found.";
	}
	return res;
}
