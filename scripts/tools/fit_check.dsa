// Tool: fit_check
// Checks a figure against furniture or other figures: which body parts go
// into them (how deep, and which way is out) and how far parts float above
// the surface under them.
//
// args:
//   figure     (string, required) label
//   against    ([string]) labels of props or figures; default: every visible
//              prop whose bounding box touches the figure's
//   max_depth  (number, default 15) deepest overlap that counts, cm
//   worn       (bool, default false) also test clothing and hair
//   floor_y    (number) also report how far each foot is above this height

function dazmcpTool(args) {
	var fig = DazMcp.requireFigure(args.figure);
	if (DazMcp.nodeType(fig) === "fitted_figure") { fig = fig.getFollowTarget(); }
	var against = [];
	var i, all, box, b, t, low;
	if (args.against && args.against.length) {
		for (i = 0; i < args.against.length; i++) { against.push(DazMcp.requireNode(args.against[i], "against")); }
	} else {
		box = DazMcp.padBox(DazMcp.bboxOf([fig]), 1);
		all = Scene.getNodeList();
		for (i = 0; i < all.length; i++) {
			t = DazMcp.nodeType(all[i]);
			if (t !== "prop" || !all[i].isVisible()) { continue; }
			try { b = all[i].getWSBoundingBox(); } catch (e) { b = null; }
			if (!b || !b.isValid()) { continue; }
			if (b.max.x < box.min[0] || b.min.x > box.max[0] || b.max.y < box.min[1] || b.min.y > box.max[1] ||
				b.max.z < box.min[2] || b.min.z > box.max[2]) { continue; }
			against.push(all[i]);
		}
	}
	var report = DazMcp.fitCheck(fig, against, { max_depth: args.max_depth, worn: args.worn === true });
	if (!against.length) { report.hints = ["No prop touches the figure's bounding box. Name the props in `against`."]; }
	if (args.floor_y !== undefined && args.floor_y !== null) {
		low = DazMcp.lowestPoints(fig, { left_foot: true, right_foot: true });
		report.feet = {};
		for (t in low) {
			if (low.hasOwnProperty(t)) { report.feet[t] = { lowest: low[t], above_floor_cm: DazMcp.round(low[t][1] - args.floor_y, 1) }; }
		}
	}
	return report;
}
