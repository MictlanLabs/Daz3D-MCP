// Tool: node_delete
// Removes nodes from the scene. Deleting a figure also removes its bones;
// clothing fitted to it is removed too when with_fitted is true.
//
// args:
//   nodes       (string[], required) labels
//   with_fitted (bool, default true) also delete what is fitted to a figure

function inScene(id) {
	var all = Scene.getNodeList();
	var k;
	for (k = 0; k < all.length; k++) {
		if (DazMcp.idOf(all[k]) === id) { return true; }
	}
	return false;
}

function dazmcpTool(args) {
	var refs = args.nodes || [];
	var withFitted = args.with_fitted !== false;
	var list = [];
	var deleted = [];
	var i, j, node, extra;
	if (!refs.length) { throw DazMcp.fail("bad_args", "nodes is required."); }
	for (i = 0; i < refs.length; i++) {
		node = DazMcp.requireNode(refs[i], "node");
		if (DazMcp.nodeType(node) === "bone") {
			throw DazMcp.fail("bad_args", refs[i] + " is a bone; delete its figure instead.");
		}
		list.push(node);
		if (withFitted) {
			extra = DazMcp.followers(node);
			for (j = 0; j < extra.length; j++) { list.push(extra[j]); }
		}
	}
	// Daz Studio 6 destroys a node as soon as it is removed (and a figure takes
	// its followers with it), so read every label and id before removing any.
	var labels = [];
	var ids = [];
	for (i = 0; i < list.length; i++) {
		labels.push(list[i].getLabel());
		ids.push(DazMcp.idOf(list[i]));
	}
	for (i = 0; i < list.length; i++) {
		if (!inScene(ids[i])) {
			deleted.push(labels[i]);  // already gone with its figure
			continue;
		}
		if (Scene.removeNode(list[i]) !== false) { deleted.push(labels[i]); }
	}
	return { deleted: deleted, node_count: Scene.getNumNodes() };
}
