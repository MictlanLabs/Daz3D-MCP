// Tool: import_mesh
// Imports an OBJ or FBX file into the scene without showing the importer's
// options dialog, then names, sizes and places what it added.
//
// args:
//   path          (string, required) absolute path of the .obj or .fbx
//   format        (string) "obj" or "fbx" (from the extension when missing)
//   scale_cm      (number) OBJ: centimeters per file unit (importer "Scale")
//   up_axis       (string) OBJ: "Y" (default) or "Z" for Z-up files
//   post_scale    (number) multiply the imported node's scale (FBX unit fixes)
//   height        (number) cm; scale it uniformly to this height
//   label         (string) label for the imported node
//   position      [x, y, z] cm
//   drop_to_floor (bool) put its lowest point at Y = 0
//   room          (bool) with drop_to_floor: put its floor at Y = 0 instead: the
//                 largest level surface with something over it (an upper floor,
//                 a ceiling, a roof) and room to stand on it (see findFloor), so
//                 neither the roof of a building nor the ground around or under
//                 it is taken for the floor
//   take          (string) FBX: animation take to read
//   options       {key: value} extra importer settings (DzFileIOSettings)
//   drop_empties  (bool) remove what came in with no mesh and nothing under it
//                 (the camera, light and empties a Blender scene exports)
//   glass         ([string]) surfaces to make clear Iray glass (see-through
//                 in the file); the PBR shader the FBX importer uses has no
//                 transparency, so they are switched to Iray Uber first

var IMPORTERS = { obj: "DzObjImporter", fbx: "DzFbxImporter" };

function setOption(settings, key, value) {
	if (typeof value === "boolean") { settings.setBoolValue(key, value); }
	else if (typeof value === "number") {
		if (Math.floor(value) === value && Math.abs(value) < 1e9) { settings.setIntValue(key, value); }
		else { settings.setFloatValue(key, value); }
	} else { settings.setStringValue(key, String(value)); }
}

function findImporter(format, path) {
	var mgr = App.getImportMgr();
	var imp = null;
	try { imp = mgr.findImporterByClassName(IMPORTERS[format]); } catch (e) { imp = null; }
	if (!imp) { try { imp = mgr.findImporter(path); } catch (e2) { imp = null; } }
	return imp;
}

var UBER_PRESET = "Shader Presets/Iray/DAZ Uber/!Iray Uber Base.duf";
var GLASS = { "Refraction Weight": 1, "Refraction Index": 1, "Thin Walled": true, "Glossy Roughness": 0.02,
	"Cutout Opacity": 1 };

function uberPreset() {
	var dirs = DazMcp.contentDirs();
	var i, f;
	for (i = 0; i < dirs.length; i++) {
		f = dirs[i].path + "/" + UBER_PRESET;
		if (DazMcp.fileExists(f)) { return f; }
	}
	return null;
}

// The meshes of an import: the roots and every prop under them.
function meshNodes(roots) {
	var out = [];
	var i;
	for (i = 0; i < roots.length; i++) { out = out.concat(DazMcp.propMeshNodes(roots[i])); }
	return out;
}

// Switches one surface to Iray Uber (when it is not) and makes it clear glass.
function makeGlass(node, index, preset) {
	var shape = node.getObject().getCurrentShape();
	var m = shape.getMaterial(index);
	var i;
	if (!DazMcp.findProp(m, "Refraction Weight")) {
		if (!preset) { return "Daz Studio's '!Iray Uber Base' shader preset is not installed"; }
		DazMcp.selectOnly(node);
		for (i = 0; i < shape.getNumMaterials(); i++) { shape.getMaterial(i).select(i === index); }
		App.getContentMgr().openFile(preset, true);
		m = shape.getMaterial(index);
		if (!DazMcp.findProp(m, "Refraction Weight")) { return "the Iray Uber shader could not be applied"; }
	}
	DazMcp.setProps(m, GLASS);
	return null;
}

function applyGlass(nodes, names, warnings) {
	var want = {}, done = [], preset = null, looked = false;
	var i, j, shape, m, err;
	for (i = 0; i < names.length; i++) { want[DazMcp.lower(names[i])] = true; }
	for (i = 0; i < nodes.length; i++) {
		try { shape = nodes[i].getObject().getCurrentShape(); } catch (e) { shape = null; }
		if (!shape) { continue; }
		for (j = 0; j < shape.getNumMaterials(); j++) {
			m = shape.getMaterial(j);
			if (!want[DazMcp.lower(m.getName())] && !want[DazMcp.lower(m.getLabel())]) { continue; }
			if (!looked && !DazMcp.findProp(m, "Refraction Weight")) { preset = uberPreset(); looked = true; }
			err = makeGlass(nodes[i], j, preset);
			if (err) { warnings.push("Surface " + m.getLabel() + " stays opaque: " + err + "."); }
			else { done.push(shape.getMaterial(j).getLabel()); }
		}
	}
	if (preset) {
		// leave no surface selected, as after a plain import
		for (i = 0; i < nodes.length; i++) {
			try { shape = nodes[i].getObject().getCurrentShape(); } catch (e2) { continue; }
			for (j = 0; j < shape.getNumMaterials(); j++) { shape.getMaterial(j).select(false); }
		}
	}
	return done;
}

// The floor of a room or building, among its large level surfaces. The
// largest one is often the roof (a flat roof is as big as the building) or
// the ground around it. The floor is the largest one that is mostly under
// something (an upper floor, a ceiling, a roof) with room to stand on it;
// of floors about that big (storeys), the lowest. COVER_GAP: a person's height.
var COVER_GAP = 150;
var COVERED = 0.5;     // share of a surface that must be under something
var BIG = 0.1;         // a floor is at least this share of the largest surface at or above it
var LOW_GAP = 3;       // cm: thinner gaps are one surface, not one over another
var CELLS = 40;        // coverage grid, cells along the longer side
var STOREY = 0.8;      // floors at least this share of the largest one count as storeys

// Share of surface s (in X/Z) that has geometry over it, as a union: each
// grid cell of the surface counts once however many storeys are above it.
// ownTris: the set s.tris points into; tris: everything that can cover it,
// counted between lo and hi cm above the surface.
function coverOf(s, ownTris, tris, lo, hi) {
	var x0 = s.xz_min[0], z0 = s.xz_min[1];
	var cell = Math.max(5, Math.max(s.xz_max[0] - x0, s.xz_max[1] - z0) / CELLS);
	var own = {}, over = {}, nOwn = 0, nOver = 0;
	var mark = function (P, o, set) {
		var a = Math.floor((Math.min(P[o], P[o + 3], P[o + 6]) - x0) / cell);
		var b = Math.floor((Math.max(P[o], P[o + 3], P[o + 6]) - x0) / cell);
		var c = Math.floor((Math.min(P[o + 2], P[o + 5], P[o + 8]) - z0) / cell);
		var d = Math.floor((Math.max(P[o + 2], P[o + 5], P[o + 8]) - z0) / cell);
		var x, z, k, added = 0;
		for (x = Math.max(a, 0); x <= Math.min(b, CELLS + 1); x++) {
			for (z = Math.max(c, 0); z <= Math.min(d, CELLS + 1); z++) {
				k = x + "," + z;
				if (!set[k]) { set[k] = true; added++; }
			}
		}
		return added;
	};
	var i, k, j;
	for (k = 0; k < s.tris.length; k++) { nOwn += mark(ownTris.p, s.tris[k] * 9, own); }
	for (j = 0; j < tris.flat.length; j++) {
		i = tris.flat[j];
		if (tris.cy[j] >= s.y + lo && tris.cy[j] <= s.y + hi) { mark(tris.p, i * 9, over); }
	}
	for (k in own) { if (own.hasOwnProperty(k) && over[k]) { nOver++; } }
	return nOwn ? nOver / nOwn : 0;
}

// The height most of a surface is at. A surface joins triangles whose heights
// step by up to 2 cm, so a floor with rugs, a step or a stage can average
// well above its boards: take the 1 cm band with the most area instead.
function mainHeight(s) {
	var bins = {}, i, o, cy, key, best = null, sum = 0, w = 0, P = s.own.p, A = s.own.area;
	for (i = 0; i < s.tris.length; i++) {
		o = s.tris[i] * 9;
		key = Math.floor((P[o + 1] + P[o + 4] + P[o + 7]) / 3);
		bins[key] = (bins[key] || 0) + A[s.tris[i]];
		if (best === null || bins[key] > bins[best]) { best = key; }
	}
	for (i = 0; i < s.tris.length; i++) {
		o = s.tris[i] * 9;
		cy = (P[o + 1] + P[o + 4] + P[o + 7]) / 3;
		if (Math.abs(cy - (best + 0.5)) <= 1.5) { sum += cy * A[s.tris[i]]; w += A[s.tris[i]]; }
	}
	return w ? sum / w : s.y;
}

// Surfaces of every root, measured against one triangle set of them all (a
// Blender export brings the floor, ceiling and roof as separate objects).
function findFloor(roots) {
	var nodes = [], all = [], i, k, found, tris = null, largest = 0, best = null, cands = [], c, fallback = null;
	for (i = 0; i < roots.length; i++) {
		nodes = nodes.concat(DazMcp.propMeshNodes(roots[i]));
		found = DazMcp.supportSurfaces(roots[i], { min_area: 10000 });
		for (k = 0; k < found.surfaces.length; k++) {
			found.surfaces[k].own = found.tris;
			all.push(found.surfaces[k]);
		}
		if (roots.length === 1) { tris = found.tris; }
	}
	if (!all.length) { return null; }
	if (!tris) { tris = DazMcp.meshTriangles(nodes, null); }
	// the triangles that can cover a floor (not walls), and their heights
	tris.flat = [];
	tris.cy = [];
	for (i = 0; i < tris.count; i++) {
		if (Math.abs(tris.n[i * 3 + 1]) < 0.2) { continue; }
		tris.flat.push(i);
		tris.cy.push((tris.p[i * 9 + 1] + tris.p[i * 9 + 4] + tris.p[i * 9 + 7]) / 3);
	}
	// Lowest first. Measured against the largest surface at or above it, so a
	// table top is too small to be the floor, but a street or terrain much
	// bigger than the building does not hide the floor either.
	all.sort(function (a, b) { return b.y - a.y; });
	for (i = 0; i < all.length; i++) {
		if (all[i].area > largest) { largest = all[i].area; }
		if (all[i].area >= BIG * largest) { cands.push(all[i]); }
		if (!fallback || all[i].area > fallback.area) { fallback = all[i]; }
	}
	var floors = [], top = 0;
	for (i = 0; i < cands.length; i++) {
		// the ground or a foundation under the floor boards has the floor right
		// over it: there is no room to stand there
		if (coverOf(cands[i], cands[i].own, tris, LOW_GAP, COVER_GAP) >= COVERED) { continue; }
		c = coverOf(cands[i], cands[i].own, tris, COVER_GAP, 1e9);
		if (c < COVERED) { continue; }
		cands[i].cover = c;
		floors.push(cands[i]);
		if (cands[i].area > top) { top = cands[i].area; }
	}
	for (i = 0; i < floors.length; i++) {
		if (floors[i].area >= STOREY * top && (!best || floors[i].y < best.y)) { best = floors[i]; }
	}
	// nothing is covered (an open set, no ceiling): the largest, as before
	if (!best) { best = fallback; best.cover = 0; }
	return { s: best, y: mainHeight(best), cover: best.cover, levels: cands.length };
}

// A power of ten that brings a size back to a room, prop or person (1 cm to 50 m).
function sizeFix(longest) {
	var s = 1;
	while (longest * s > 5000) { s /= 10; }
	while (longest * s < 1) { s *= 10; }
	return s;
}

function dazmcpTool(args) {
	var path = args.path;
	var format = DazMcp.lower(args.format || String(path).replace(/^.*\./, ""));
	var importer, settings, before, err, added, roots, root, i, key, box, warnings, f, p, s, h;
	if (!path) { throw DazMcp.fail("bad_args", "path is required."); }
	if (!DazMcp.fileExists(path)) { throw DazMcp.fail("not_found", "File not found: " + path); }
	if (!IMPORTERS[format]) { throw DazMcp.fail("bad_args", "Daz Studio imports .obj and .fbx files, not ." + format + "."); }
	importer = findImporter(format, path);
	if (!importer) { throw DazMcp.fail("no_importer", "Daz Studio has no " + format.toUpperCase() + " importer."); }

	settings = new DzFileIOSettings();
	try { importer.getDefaultOptions(settings); } catch (e0) { /* start empty */ }
	if (format === "obj") {
		settings.setStringValue("Preset", "Custom");
		settings.setFloatValue("Scale", Number(args.scale_cm || 1));
		if (DazMcp.lower(args.up_axis) === "z") {
			// Daz is Y up: file Z becomes Y, file Y becomes -Z.
			settings.setStringValue("LatAxis", "X");
			settings.setStringValue("VertAxis", "Z");
			settings.setStringValue("DepthAxis", "Y");
			settings.setBoolValue("InvertDepth", true);
		} else {
			settings.setStringValue("LatAxis", "X");
			settings.setStringValue("VertAxis", "Y");
			settings.setStringValue("DepthAxis", "Z");
			settings.setBoolValue("InvertDepth", false);
		}
		settings.setBoolValue("InvertLat", false);
		settings.setBoolValue("InvertVert", false);
		settings.setBoolValue("IncludeVT", true);
		settings.setBoolValue("IncludeG", true);
		settings.setBoolValue("IncludeUsemtl", true);
		settings.setBoolValue("IncludeMtllib", true);
	} else if (args.take) {
		settings.setStringValue("Take", args.take);
	}
	if (args.options) {
		for (key in args.options) {
			if (args.options.hasOwnProperty(key)) { setOption(settings, key, args.options[key]); }
		}
	}
	settings.setIntValue("RunSilent", 1);

	before = DazMcp.snapshot();
	Scene.selectAllNodes(false);
	err = importer.readFile(path, settings);
	try { importer.deleteLater(); } catch (e1) { /* not a QObject here */ }
	if (err !== undefined && err !== null && err !== true && Number(err) !== 0) {
		throw DazMcp.fail("import_failed", "Daz Studio could not import " + path + ": " +
			(typeof getErrorMessage === "function" ? getErrorMessage(err) : String(err)), { path: path });
	}

	added = DazMcp.addedSince(before);
	if (!added.length) {
		throw DazMcp.fail("import_failed", "The importer finished but nothing was added to the scene.", { path: path });
	}
	// Blender exports its scene camera and light as nodes with nothing in them.
	var dropped = [];
	if (args.drop_empties === true) {
		var kept = [];
		for (i = 0; i < added.length; i++) {
			if (DazMcp.nodeType(added[i]) === "node" && DazMcp.className(added[i]) === "DzNode" &&
				!added[i].getNodeChildren(false).length && added.length - dropped.length > 1) {
				dropped.push(added[i].getLabel());
				Scene.removeNode(added[i]);
			} else {
				kept.push(added[i]);
			}
		}
		added = kept;
	}
	// The top nodes of what was imported (an FBX can bring a hierarchy).
	var ids = {};
	for (i = 0; i < added.length; i++) { ids[DazMcp.idOf(added[i])] = true; }
	roots = [];
	for (i = 0; i < added.length; i++) {
		p = added[i].getNodeParent();
		if (!p || !ids[DazMcp.idOf(p)]) { roots.push(added[i]); }
	}
	root = roots[0];
	if (args.label && roots.length === 1) { root.setLabel(args.label); }

	warnings = [];
	var glass = args.glass && args.glass.length ? applyGlass(meshNodes(roots), args.glass, warnings) : [];
	if (args.post_scale && args.post_scale !== 1) {
		for (i = 0; i < roots.length; i++) {
			s = roots[i].getScaleControl();
			s.setValue(s.getValue() * args.post_scale);
		}
	}
	if (args.height) {
		box = DazMcp.bboxOf(roots);
		h = box ? box.max[1] - box.min[1] : 0;
		if (h > 0) {
			f = args.height / h;
			for (i = 0; i < roots.length; i++) {
				s = roots[i].getScaleControl();
				s.setValue(s.getValue() * f);
			}
		} else {
			warnings.push("The mesh has no height, so height was ignored.");
		}
	}
	var pos = DazMcp.checkVec(args.position, "position");
	if (pos) {
		for (i = 0; i < roots.length; i++) { DazMcp.setTransform(roots[i], pos, null, null); }
	}
	var floorInfo = null;
	if (args.drop_to_floor === true) {
		box = DazMcp.bboxOf(roots);
		var lift = box ? -box.min[1] : 0;
		if (args.room === true) {
			// A room's lowest point is often the ground or scenery outside it:
			// stand its floor on Y = 0 instead.
			var fl = findFloor(roots), best = fl ? fl.s : null;
			if (best) {
				lift = -fl.y;
				floorInfo = { was_at_y: DazMcp.round(fl.y, 1), size_cm: [DazMcp.round(best.size[0], 1), DazMcp.round(best.size[1], 1)],
					below_floor_cm: box ? DazMcp.round(fl.y - box.min[1], 1) : 0,
					covered: DazMcp.round(fl.cover, 2), levels: fl.levels };
				if (box && box.max[1] - fl.y > 450) {
					floorInfo.above_floor_cm = DazMcp.round(box.max[1] - fl.y, 1);
				}
				if (!fl.cover) {
					warnings.push("Nothing was found over its largest level surface (no ceiling or upper floor), so " +
						"that is taken for the floor. If it is a roof, use position to lower the model.");
				}
			} else {
				warnings.push("No level surface of 1 m2 or more was found for a floor; its lowest point is at Y = 0.");
			}
		}
		for (i = 0; i < roots.length; i++) {
			p = roots[i].getYPosControl();
			p.setValue(p.getValue() + lift);
		}
	}

	box = DazMcp.bboxOf(roots);
	var info = DazMcp.boxInfo(box);
	var fix = 1;
	if (info) {
		h = info.size[1];
		var longest = Math.max(info.size[0], info.size[1], info.size[2]);
		fix = longest > 0 ? sizeFix(longest) : 1;
		if (fix < 1) {
			warnings.push("It is " + DazMcp.round(longest / 100, 1) + " m across, too big for a room, prop or person: " +
				"the model is probably " + DazMcp.round(1 / fix, 0) + "x too big (an unapplied object scale or a wrong " +
				"unit). Import it again with scale=" + fix + ", or use height=...");
		} else if (fix > 1) {
			warnings.push("It is only " + DazMcp.round(longest, 3) + " cm across: the model is probably " + fix +
				"x too small (wrong units). Import it again with scale=" + fix + ", or use height=...");
		}
	}

	var nodes = [];
	for (i = 0; i < added.length && nodes.length < 50; i++) {
		nodes.push({ label: added[i].getLabel(), type: DazMcp.nodeType(added[i]) });
	}
	var out = {
		imported: path,
		format: format,
		label: root.getLabel(),
		type: DazMcp.nodeType(root),
		roots: DazMcp.labels(roots),
		nodes: nodes,
		bbox: info,
		surfaces: DazMcp.surfaceLabels(root),
		scale: DazMcp.round(root.getScaleControl().getValue(), 4),
		warnings: warnings
	};
	if (fix !== 1 && info) { out.suggested_scale = fix; }
	if (dropped.length) { out.removed_empty_nodes = dropped; }
	if (floorInfo) { out.floor = floorInfo; }
	if (glass.length) { out.glass_surfaces = glass; }
	if (out.type === "figure") {
		out.bones = DazMcp.bones(root).length;
		out.note = "It came with its own skeleton. It is not a Genesis rig: use wearable_from_mesh to make it " +
			"follow a Genesis figure.";
	}
	DazMcp.selectOnly(root);
	return out;
}
